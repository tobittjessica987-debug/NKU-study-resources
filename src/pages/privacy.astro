---
import Layout from "../layouts/Layout.astro";
import { readBuildData } from "../lib/runtime-data";
import { markdownToHtml } from "../lib/markdown";
import { CURRENT_PRIVACY_RULES_CONTENT, DEFAULT_PRIVACY_CONTENT, effectivePrivacyDocument } from "../../server/default-privacy.mjs";

let savedPrivacy = null;
try {
  savedPrivacy = readBuildData("privacy.json");
} catch {
  // privacy.json 尚未保存过时使用默认文案；后台保存并发布会重建本页
}
const { document: privacy, customNeedsReview } = effectivePrivacyDocument(savedPrivacy);
// The complete default is also used by the editor. Render its common rules once
// here; unknown custom text is preserved in full as supplementary explanation.
const supplementaryContent = privacy.content === DEFAULT_PRIVACY_CONTENT.content
  ? privacy.content.replace(CURRENT_PRIVACY_RULES_CONTENT, "")
  : privacy.content;
---

<Layout title={privacy.title || "隐私政策与用户协议"} eyebrow="Privacy">
  <section class="content">
    <article class="panel">
      <div class="panel-header split-header">
        <h2>{privacy.title || "隐私政策与用户协议"}</h2>
        <div class="header-actions">
          <a class="button secondary" href="/report/">私密投诉举报</a>
          <a class="button secondary" href="/admin/" target="_blank" rel="noreferrer">管理</a>
        </div>
      </div>
      <div class="panel-body">
        <div class="markdown-body" data-current-privacy-rules set:html={markdownToHtml(CURRENT_PRIVACY_RULES_CONTENT)} />
        <p class="muted">投诉举报可<a href="/report/">匿名私密提交</a>，始终不在公共页面展示。提交时关联的有效账号可在<a href="/me/">我的反馈</a>查看允许返回的处理回复；匿名提交或注销账号后无法通过原账号查看回复。</p>
        {customNeedsReview && <p class="muted" data-custom-privacy-review>下方为运营方保存的其他政策说明，其中与上方现行规则不一致的内容须由运营方核对修订。账号注销与内容处理以上方现行规则为准。</p>}
        <div class="markdown-body" data-saved-privacy-content set:html={markdownToHtml(supplementaryContent || "")} />
      </div>
    </article>
  </section>
</Layout>
