    function bindAdminNavState() {
      const permissions = new Set(sessionState?.permissions || []);
      for (const item of adminElements(".admin-nav-item", HTMLElement)) {
        const required = tabPermissions[item.dataset.adminTab || ""];
        const allowed = !required || permissions.has(required);
        item.classList.toggle("admin-nav-item--locked", !allowed);
        item.title = allowed ? "" : `需要「${permissionLabels[required] || required}」权限`;
        item.classList.toggle("secondary", item.dataset.adminTab !== currentAdminTab);
      }
    }

