    function serverPermissionPoints() {
      return accountsState?.permissionPoints && accountsState.permissionPoints.length
        ? accountsState.permissionPoints
        : Object.keys(permissionLabels);
    }

    function renderPermissionEditor(container: HTMLElement, checked: string[]) {
      container.innerHTML = "";
      for (const permission of serverPermissionPoints()) {
        const label = permissionLabels[permission] || permission;
        const box = document.createElement("label");
        box.className = "perm-check";
        box.innerHTML = `<input type="checkbox" value="${permission}" ${checked.includes(permission) ? "checked" : ""} /> ${escapeHtml(label)}`;
        container.append(box);
      }
    }

    function checkedPermissions(container: HTMLElement) {
      return [...adminElements("input[type=checkbox]:checked", HTMLInputElement, container)].map((item) => item.value);
    }

