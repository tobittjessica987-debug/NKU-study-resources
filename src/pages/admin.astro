function collectAiSettingsWrite(): AdminTypes.AiSettingsWrite {
  const apiKeyInput = requireAdminElement("#ai-api-key", HTMLInputElement).value.trim();
  const body: AdminTypes.AiSettingsWrite = {
    settings: {
      enabled: requireAdminElement("#ai-enabled", HTMLSelectElement).value === "true",
      base_url: requireAdminElement("#ai-base-url", HTMLInputElement).value.trim(),
      model: requireAdminElement("#ai-model", HTMLInputElement).value.trim(),
      max_tokens: Number(requireAdminElement("#ai-max-tokens", HTMLInputElement).value),
      daily_limit_per_user: Number(requireAdminElement("#ai-daily-user", HTMLInputElement).value),
      minute_limit_per_user: Number(requireAdminElement("#ai-minute-user", HTMLInputElement).value),
      daily_limit_global: Number(requireAdminElement("#ai-daily-global", HTMLInputElement).value),
    },
  };
  if (apiKeyInput) body.api_key = apiKeyInput;
  if (aiAdminState.clearKey) body.clear_api_key = true;
  return body;
}

async function saveAiAdmin() {
  const status = requireAdminElement("#ai-status", HTMLElement);
  status.textContent = "保存中...";
  const body = collectAiSettingsWrite();
  try {
    await api("/ai-settings", { method: "POST", body: JSON.stringify(body) });
    await loadAiAdmin();
    status.textContent = "已保存，正在自动测试连接...";
    await testAiAdmin();
  } catch (error) {
    status.textContent = adminErrorMessage(error);
  }
}

async function testAiAdmin() {
  const status = requireAdminElement("#ai-status", HTMLElement);
  status.textContent = "测试中（最多 15 秒）...";
  const body = collectAiSettingsWrite();
  if (aiAdminState.clearKey) {
    status.textContent = "已选择清除密钥，请先保存再测试。";
    return;
  }
  try {
    const data = await api("/ai-settings/test", { method: "POST", body: JSON.stringify(body) });
    const result = data.data;
    if (result.ok) status.textContent = `连接成功：模型 ${result.model}，延迟 ${result.latency_ms}ms，回复「${result.preview}」。`;
    else status.textContent = `连接失败：${result.reason}${result.error ? `（${result.error}）` : ""}`;
  } catch (error) {
    status.textContent = adminErrorMessage(error);
  }
}

function bindAiAdminEvents() {
  requireAdminElement("#ai-save", HTMLButtonElement).addEventListener("click", saveAiAdmin);
  requireAdminElement("#ai-test", HTMLButtonElement).addEventListener("click", testAiAdmin);
  requireAdminElement("#ai-clear-key", HTMLButtonElement).addEventListener("click", () => {
    aiAdminState.clearKey = !aiAdminState.clearKey;
    requireAdminElement("#ai-clear-key", HTMLButtonElement).textContent = aiAdminState.clearKey ? "撤销清除" : "清除密钥";
    requireAdminElement("#ai-status", HTMLElement).textContent = aiAdminState.clearKey ? "保存后将清除已配置的密钥。" : "";
  });
}

async function loadServiceKeysAdmin() {
  const data = await api("/service-keys");
