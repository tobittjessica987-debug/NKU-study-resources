        const label = button.textContent;
        button.textContent = "清理中…";
        button.disabled = true;
        try {
          const data = await api("/content-images/cleanup", { method: "POST", body: JSON.stringify({ owner }) });
          button.textContent = label;
          button.disabled = false;
          const row = button.closest(".filter-row");
          const status = row ? findAdminElement(".muted", HTMLElement, row) : null;
          if (status) status.textContent = `清理完成：扫描 ${data.data.scanned} 张，删除 ${data.data.removed} 张，保留引用中 ${data.data.kept} 张`;
        } catch (error) {
          button.textContent = label;
          button.disabled = false;
          alert(adminErrorMessage(error) || "清理失败");
