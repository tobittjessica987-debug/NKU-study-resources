    function renderAccountsAdmin() {
      const current = accountsState;
      if (!current) return;
      accountsAdminList.innerHTML = "";
      const table = document.createElement("table");
      table.className = "admin-table";
      table.innerHTML = `
        <thead><tr><th style="width: 14%;">账号</th><th style="width: 36%;">权限</th><th style="width: 7%;">启用</th><th style="width: 17%;">最近登录</th><th style="width: 26%;">操作</th></tr></thead>
        <tbody></tbody>
      `;
      const body = requireAdminElement("tbody", HTMLElement, table);
      for (const account of current.accounts) {
        const row = document.createElement("tr");
        const permTags = account.permissions.map((item) => `<span class="perm-tag">${escapeHtml(permissionLabels[item] || item)}</span>`).join("");
        row.innerHTML = `
          <td style="width: 14%;">${escapeHtml(account.username)}${account.username === sessionState.username ? ' <span class="muted">(我)</span>' : ""}</td>
          <td style="width: 36%;">${permTags || "-"}${account.mustChangePassword ? ' <span class="muted">[待改密]</span>' : ""}</td>
          <td style="width: 6%;">${account.enabled ? "是" : "否"}</td>
          <td style="width: 16%;">${account.lastLoginAt ? escapeHtml(beijingDateTime(new Date(account.lastLoginAt))) : "从未"}</td>
          <td style="width: 28%;" class="admin-table-ops"></td>
        `;
        const ops = document.createElement("div");
        ops.className = "ops-row";
        requireAdminElement("td:last-child", HTMLElement, row).append(ops);

        const editButton = document.createElement("button");
        editButton.type = "button";
        editButton.className = "button secondary";
        editButton.textContent = "编辑";
        editButton.addEventListener("click", () => renderAccountEditor(row, account));
        ops.append(editButton);

        const resetButton = document.createElement("button");
        resetButton.type = "button";
        resetButton.className = "button secondary";
        resetButton.textContent = "重置密码";
        resetButton.addEventListener("click", async () => {
          const next = window.prompt(`为 ${account.username} 设置新密码（至少 10 位）：`);
          if (!next) return;
          try {
            await api(`/accounts/${account.id}/password`, {
              method: "POST",
              body: JSON.stringify({ password: next, mustChangePassword: true }),
            });
            accountsAdminStatus.textContent = `已重置 ${account.username} 的密码`;
            await loadAccountsAdmin();
          } catch (error) {
            accountsAdminStatus.textContent = adminErrorMessage(error);
          }
        });
        ops.append(resetButton);

        if (account.username !== sessionState.username) {
          const deleteButton = document.createElement("button");
          deleteButton.type = "button";
          deleteButton.className = "button secondary";
          deleteButton.textContent = "删除";
          deleteButton.addEventListener("click", async () => {
            if (!window.confirm(`确定删除账号 ${account.username}？`)) return;
            try {
              await api(`/accounts/${account.id}`, { method: "DELETE" });
              accountsAdminStatus.textContent = `已删除 ${account.username}`;
              await loadAccountsAdmin();
            } catch (error) {
              accountsAdminStatus.textContent = adminErrorMessage(error);
            }
          });
          ops.append(deleteButton);
        }
        body.append(row);
      }
      accountsAdminList.append(table);
    }

    function renderAccountEditor(row: HTMLTableRowElement, account: AdminTypes.AdminAccount) {
      const existing = findAdminElement(".account-editor-row", HTMLElement, accountsAdminList);
      if (existing) existing.remove();
      const editorRow = document.createElement("tr");
      editorRow.className = "account-editor-row";
      const cell = document.createElement("td");
      cell.colSpan = 5;
      const roleSelect = document.createElement("select");
      roleSelect.className = "searchbar";
      const presets = serverRolePresets();
      roleSelect.innerHTML = `<option value="">自定义</option>${Object.keys(presets).map((role) => `<option value="${role}">${role}</option>`).join("")}`;
      roleSelect.addEventListener("change", () => {
        if (roleSelect.value) renderPermissionEditor(permBox, presets[roleSelect.value]);
      });
      const permBox = document.createElement("div");
      permBox.className = "filter-row";
      renderPermissionEditor(permBox, account.permissions);
      const enabledBox = document.createElement("label");
      enabledBox.innerHTML = `<input type="checkbox" ${account.enabled ? "checked" : ""} /> 启用`;
      const mustChangeBox = document.createElement("label");
      mustChangeBox.innerHTML = `<input type="checkbox" ${account.mustChangePassword ? "checked" : ""} /> 下次登录强制改密`;
      const saveButton = document.createElement("button");
      saveButton.type = "button";
      saveButton.className = "button";
      saveButton.textContent = "保存";
      saveButton.addEventListener("click", async () => {
        try {
          await api(`/accounts/${account.id}`, {
            method: "PATCH",
            body: JSON.stringify({
              permissions: checkedPermissions(permBox),
              enabled: requireAdminElement("input", HTMLInputElement, enabledBox).checked,
              mustChangePassword: requireAdminElement("input", HTMLInputElement, mustChangeBox).checked,
            }),
          });
          accountsAdminStatus.textContent = `已更新 ${account.username}`;
          await loadAccountsAdmin();
        } catch (error) {
          accountsAdminStatus.textContent = adminErrorMessage(error);
        }
      });
      const cancelButton = document.createElement("button");
      cancelButton.type = "button";
      cancelButton.className = "button secondary";
      cancelButton.textContent = "取消";
      cancelButton.addEventListener("click", () => editorRow.remove());
      const layout = document.createElement("div");
      layout.className = "admin-form";
      layout.append(roleSelect, permBox, enabledBox, mustChangeBox, saveButton, cancelButton);
      cell.append(layout);
      editorRow.append(cell);
      row.after(editorRow);
    }

