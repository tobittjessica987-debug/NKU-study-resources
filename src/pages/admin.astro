    // ---- 站点配色：本地预览（仅本机会话）+ 保存到全站 ----
    const THEME_VARIABLE_LABELS: Record<string, string> = {
      "--bg": "页面背景",
      "--primary": "主色",
      "--primary-dark": "主色（深）",
      "--accent": "强调色（金）",
      "--primary-soft-bg": "浅主色底",
      "--primary-soft-border": "浅主色边框",
      "--primary-border": "主色边框",
      "--primary-bright": "高亮文字",
      "--primary-strong-border": "深主色边框",
      "--primary-tint-bg": "主色半透明底",
      "--primary-deep-tint": "深主色半透明底",
      "--button-bg": "按钮底色",
      "--top-link-bg": "顶部链接底色",
      "--top-link-bg-hover": "顶部链接底色（悬停）",
      "--top-link-border-hover": "顶部链接边框（悬停）",
      "--topbar-bg": "顶栏底色",
      "--sidebar-bg": "侧栏底色",
    };
    const THEME_DEFAULTS: Record<"light" | "dark", Record<string, string>> = {
      light: {
        "--bg": "#f4f6fb",
        "--primary": "#4f2683", "--primary-dark": "#3d1e68", "--accent": "#b8912f",
        "--primary-soft-bg": "#f5f0fb", "--primary-soft-border": "#d9cbee", "--primary-border": "#bfa7e0",
        "--button-bg": "var(--primary)", "--top-link-bg": "rgba(255, 255, 255, 0.12)",
        "--top-link-bg-hover": "rgba(255, 255, 255, 0.12)", "--top-link-border-hover": "rgba(255, 255, 255, 0.35)",
        "--topbar-bg": "var(--primary)", "--sidebar-bg": "var(--surface)",
      },
      dark: {
        "--bg": "#191d20",
        "--primary": "#8a63c9", "--primary-dark": "#a98ada", "--accent": "#d4b45a",
        "--primary-bright": "#b9a0e8", "--primary-strong-border": "#5b3a94",
        "--primary-tint-bg": "rgba(138, 99, 201, 0.18)", "--primary-deep-tint": "rgba(79, 38, 131, 0.32)",
        "--button-bg": "#4a2d78", "--top-link-bg": "#38235c", "--top-link-bg-hover": "#47296f",
        "--top-link-border-hover": "#7a57ab", "--topbar-bg": "#2a1a47", "--sidebar-bg": "#1e1a26",
      },
    };
    let themePreviewMode: "light" | "dark" = "light";
    type ThemeOverrides = Record<"light" | "dark", Record<string, string>>;
    let themeActive: ThemeOverrides = { light: {}, dark: {} };
    let themeCustomDefault: ThemeOverrides = { light: {}, dark: {} };
    let themeCustom: ThemeOverrides = { light: {}, dark: {} };
    type ThemePreset = { id: string; name: string } & ThemeOverrides;
    let themePresets: ThemePreset[] = [];
    const THEME_PREVIEW_KEY = "nkustudy-theme-preview";
    const persistLocalPreview = () => {
      // 本机预览写入 localStorage：同源所有页面（含前台）同步生效，仅本浏览器。
      try {
        localStorage.setItem(THEME_PREVIEW_KEY, JSON.stringify(themeCustom));
      } catch { /* 存储失败时仅管理页内预览 */ }
    };
    const clearLocalPreview = () => {
      try { localStorage.removeItem(THEME_PREVIEW_KEY); } catch { /* ignore */ }
      themePreviewStyle.textContent = "";
    };
    const themeStatusLabel = requireAdminElement("#theme-status", HTMLElement);
    const themePreviewStyle = document.createElement("style");
    themePreviewStyle.id = "nkustudy-theme-preview";
    document.head.append(themePreviewStyle);
    themePreviewStyle.textContent = "";

    const buildThemeCss = (custom: Record<string, string>, extraMode: "light" | "dark") => {
      const modes: Array<["light" | "dark", string]> = [["light", ":root:root"], ["dark", ':root:root[data-theme="dark"]']];
      return modes.map(([mode, selector]) => {
        const merged = { ...THEME_DEFAULTS[mode], ...(mode === extraMode ? (custom || {}) : {}) };
        const body = Object.entries(merged).map(([k, v]) => `${k}:${v};`).join("\n");
        return `${selector}{${body}}`;
      }).join("\n");
    };

    function renderThemeColorInputs() {
      for (const mode of ["light", "dark"] as const) {
        const container = requireAdminElement(mode === "light" ? "#theme-colors-light" : "#theme-colors-dark", HTMLElement);
        container.innerHTML = "";
        if (mode !== themePreviewMode) {
          container.style.display = "none";
          continue;
        }
        container.style.display = "";
        const title = document.createElement("strong");
        title.textContent = mode === "light" ? "亮色模式" : "暗色模式";
        title.style.width = "100%";
        container.append(title);
        for (const [variable, label] of Object.entries(THEME_VARIABLE_LABELS)) {
          if (!(variable in THEME_DEFAULTS[mode])) continue;
          const wrap = document.createElement("label");
          wrap.className = "admin-field";
          wrap.style.flex = "1 1 150px";
          const caption = document.createElement("span");
          caption.textContent = label;
          const colorInput = document.createElement("input");
          colorInput.type = "color";
          const current = themeCustom[mode][variable] ?? THEME_DEFAULTS[mode][variable];
          if (/^#[0-9a-fA-F]{6}$/.test(current)) colorInput.value = current;
          const textInput = document.createElement("input");
          textInput.type = "text";
          textInput.value = current;
          textInput.style.marginTop = "4px";
          textInput.placeholder = "#RRGGBB 或 rgba(...)";
          colorInput.addEventListener("input", () => {
            textInput.value = colorInput.value;
            themeCustom[mode][variable] = colorInput.value;
            applyPreviewStyle();
            persistLocalPreview();
          });
          textInput.addEventListener("change", () => {
            const value = textInput.value.trim();
            const valid = /^#[0-9a-fA-F]{6}$/.test(value) || /^rgba\(\s*\d+\s*,\s*\d+\s*,\s*\d+\s*,\s*(0|1|0?\.\d+)\s*\)$/.test(value);
            if (!valid) {
              themeStatusLabel.textContent = "色值格式无效（仅支持 #RRGGBB 或 rgba(r,g,b,a)）。";
              return;
            }
            themeStatusLabel.textContent = "";
            themeCustom[mode][variable] = value;
            if (/^#[0-9a-fA-F]{6}$/.test(value)) colorInput.value = value;
            applyPreviewStyle();
            persistLocalPreview();
          });
          wrap.append(caption, colorInput, textInput);
          container.append(wrap);
        }
      }
    }

    const readLocalPreview = (): ThemeOverrides | null => {
      try {
        const raw = localStorage.getItem(THEME_PREVIEW_KEY);
        if (!raw) return null;
        const parsed = JSON.parse(raw);
        if (!parsed || typeof parsed !== "object") return null;
        const pick = (mode: "light" | "dark"): Record<string, string> => {
          const out: Record<string, string> = {};
          for (const [key, value] of Object.entries(parsed[mode] || {})) {
            if (typeof key === "string" && key.startsWith("--") && typeof value === "string") out[key] = value;
          }
          return out;
        };
        return { light: pick("light"), dark: pick("dark") };
      } catch {
        return null;
      }
    };

    const applyPreviewStyle = () => {
      themePreviewStyle.textContent = buildThemeCss(themeCustom[themePreviewMode], themePreviewMode);
    };

    const loadThemeSettings = async () => {
      const data = await api("/theme-settings") as AdminTypes.AdminActionResponse & { data?: { active?: ThemeOverrides; customDefault?: ThemeOverrides; presets?: ThemePreset[] } };
      themeActive = data.data?.active || { light: {}, dark: {} };
      themeCustomDefault = data.data?.customDefault || { light: {}, dark: {} };
      themePresets = Array.isArray(data.data?.presets) ? data.data!.presets! : [];
      themeCustom = {
        light: { ...themeActive.light },
        dark: { ...themeActive.dark },
      };
      const localPreview = readLocalPreview();
      if (localPreview && (Object.keys(localPreview.light).length || Object.keys(localPreview.dark).length)) {
        themeCustom = localPreview;
        applyPreviewStyle();
        themeStatusLabel.textContent = "已恢复上次保存的本机预览。";
      }
      renderThemeColorInputs();
      renderThemePresetList();
    };

    const themePreviewModeButton = requireAdminElement("#theme-preview-mode", HTMLButtonElement);
    themePreviewModeButton.addEventListener("click", () => {
      themePreviewMode = themePreviewMode === "light" ? "dark" : "light";
      themePreviewModeButton.textContent = "当前预览：" + (themePreviewMode === "light" ? "亮色模式（点击切换）" : "暗色模式（点击切换）");
      document.documentElement.dataset.theme = themePreviewMode;
      renderThemeColorInputs();
    });

    const buildActivePayload = () => {
      const active: ThemeOverrides = { light: {}, dark: {} };
      for (const mode of ["light", "dark"] as const) {
        for (const [variable, value] of Object.entries(themeCustom[mode] || {})) {
          if (value !== THEME_DEFAULTS[mode][variable]) active[mode][variable] = value;
        }
      }
      return active;
    };

    requireAdminElement("#theme-save", HTMLButtonElement).addEventListener("click", async () => {
      if (!confirm("保存配色并应用到全站？此方案同时会成为你的默认配色（“恢复默认”回到这里），所有访客约 1 分钟内看到新配色。")) return;
      themeStatusLabel.textContent = "保存中...";
      try {
        const data = await api("/theme-settings", { method: "POST", body: JSON.stringify({ data: { active: buildActivePayload() } }) }) as AdminTypes.AdminActionResponse & { data?: { active?: ThemeOverrides; customDefault?: ThemeOverrides } };
        themeActive = data.data?.active || { light: {}, dark: {} };
        themeCustomDefault = data.data?.customDefault || themeActive;
        renderThemePresetList();
        clearLocalPreview();
        themeStatusLabel.textContent = "已保存并应用到全站，此方案同时记为你的默认配色。";
      } catch (error) {
        themeStatusLabel.textContent = adminErrorMessage(error);
      }
    });

    requireAdminElement("#theme-save-local", HTMLButtonElement).addEventListener("click", () => {
      persistLocalPreview();
      applyPreviewStyle();
      themeStatusLabel.textContent = "本机预览已保存：本浏览器打开网站任何页面都会应用这套预览配色（其他访客不受影响）。";
    });

    const renderThemePresetList = () => {
      const list = requireAdminElement("#theme-preset-list", HTMLElement);
      list.innerHTML = "";
      if (!themePresets.length) {
        const empty = document.createElement("p");
        empty.className = "empty";
        empty.textContent = "尚未保存配色方案。";
        list.append(empty);
        return;
      }
      const defaultKey = JSON.stringify([themeCustomDefault.light, themeCustomDefault.dark]);
      for (const preset of themePresets) {
        const row = document.createElement("div");
        row.className = "filter-row";
        row.style.marginTop = "6px";
        const name = document.createElement("strong");
        name.textContent = preset.name;
        name.style.flex = "0 0 auto";
        const isDefault = JSON.stringify([preset.light, preset.dark]) === defaultKey;
        if (isDefault) {
          const badge = document.createElement("span");
          badge.className = "muted";
          badge.textContent = "（默认）";
          name.append(badge);
        }
        const applyButton = document.createElement("button");
        applyButton.type = "button";
        applyButton.className = "button secondary";
        applyButton.textContent = "本机预览此方案";
        applyButton.addEventListener("click", () => {
          themeCustom = {
            light: { ...preset.light },
            dark: { ...preset.dark },
          };
          persistLocalPreview();
          applyPreviewStyle();
          renderThemeColorInputs();
          themeStatusLabel.textContent = "已在预览中应用方案「" + preset.name + "」（仅本机）。";
        });
        const activateButton = document.createElement("button");
        activateButton.type = "button";
        activateButton.className = "button secondary";
        activateButton.textContent = "应用到全站";
        activateButton.addEventListener("click", async () => {
          if (!confirm("将方案「" + preset.name + "」应用到全站？")) return;
          try {
            const data = await api("/theme-settings", { method: "POST", body: JSON.stringify({ data: { active: { light: preset.light, dark: preset.dark } } }) }) as AdminTypes.AdminActionResponse & { data?: { active?: ThemeOverrides } };
            themeActive = data.data?.active || { light: {}, dark: {} };
            themeStatusLabel.textContent = "方案「" + preset.name + "」已应用到全站。";
          } catch (error) {
            themeStatusLabel.textContent = adminErrorMessage(error);
          }
        });
        const defaultButton = document.createElement("button");
        defaultButton.type = "button";
        defaultButton.className = "button secondary";
        defaultButton.textContent = "设为默认";
        defaultButton.addEventListener("click", async () => {
          try {
            const data = await api("/theme-settings", { method: "POST", body: JSON.stringify({ data: { customDefault: { light: preset.light, dark: preset.dark } } }) }) as AdminTypes.AdminActionResponse & { data?: { customDefault?: ThemeOverrides } };
            themeCustomDefault = data.data?.customDefault || { light: {}, dark: {} };
            renderThemePresetList();
            themeStatusLabel.textContent = "方案「" + preset.name + "」已设为默认。";
          } catch (error) {
            themeStatusLabel.textContent = adminErrorMessage(error);
          }
        });
        const deleteButton = document.createElement("button");
        deleteButton.type = "button";
        deleteButton.className = "button secondary";
        deleteButton.textContent = "删除";
        deleteButton.addEventListener("click", async () => {
          if (!confirm("删除方案「" + preset.name + "」？")) return;
          themePresets = themePresets.filter(item => item.id !== preset.id);
          try {
            await api("/theme-settings", { method: "POST", body: JSON.stringify({ data: { presets: themePresets.map(({ id, name, light, dark }) => ({ id, name, light, dark })) } }) });
            renderThemePresetList();
            themeStatusLabel.textContent = "方案已删除。";
          } catch (error) {
            themeStatusLabel.textContent = adminErrorMessage(error);
          }
        });
        row.append(name, applyButton, activateButton, defaultButton, deleteButton);
        list.append(row);
      }
    };

    requireAdminElement("#theme-preset-add", HTMLButtonElement).addEventListener("click", async () => {
      const name = prompt("为新配色方案命名（1–40 字）：");
      if (!name || !name.trim()) return;
      const preset: ThemePreset = {
        id: "preset-" + Date.now().toString(36) + "-" + Math.random().toString(36).slice(2, 8),
        name: name.trim().slice(0, 40),
        light: { ...themeCustom.light },
        dark: { ...themeCustom.dark },
      };
      const duplicates = themePresets.some(item => item.name === preset.name);
      if (duplicates) {
        themeStatusLabel.textContent = "已存在同名方案，请换一个名称。";
        return;
      }
      themePresets = [...themePresets, preset].slice(0, 12);
      try {
        await api("/theme-settings", { method: "POST", body: JSON.stringify({ data: { presets: themePresets.map(({ id, name: presetName, light, dark }) => ({ id, name: presetName, light, dark })) } }) });
        renderThemePresetList();
        themeStatusLabel.textContent = "方案「" + preset.name + "」已保存。";
      } catch (error) {
        themeStatusLabel.textContent = adminErrorMessage(error);
      }
    });

    requireAdminElement("#theme-reset-local", HTMLButtonElement).addEventListener("click", () => {
      themeCustom = {
        light: { ...themeActive.light },
        dark: { ...themeActive.dark },
      };
      clearLocalPreview();
      renderThemeColorInputs();
      themeStatusLabel.textContent = "已清除本机预览（回到当前已保存的配色）。";
    });

    requireAdminElement("#theme-reset", HTMLButtonElement).addEventListener("click", async () => {
      const hasCustomDefault = Object.keys(themeCustomDefault.light).length + Object.keys(themeCustomDefault.dark).length > 0;
      if (!hasCustomDefault) {
        themeStatusLabel.textContent = "还没有保存过默认配色：先用「保存并设为默认配色」保存一套，之后恢复默认就回到它。";
        return;
      }
      if (!confirm("恢复到你保存过的默认配色？")) return;
      try {
        const data = await api("/theme-settings", { method: "DELETE" }) as AdminTypes.AdminActionResponse & { data?: { active?: ThemeOverrides } };
        themeActive = data.data?.active || { light: {}, dark: {} };
        themeCustom = {
          light: { ...themeActive.light },
          dark: { ...themeActive.dark },
        };
        clearLocalPreview();
        renderThemeColorInputs();
        themeStatusLabel.textContent = "已恢复默认配色。";
      } catch (error) {
        themeStatusLabel.textContent = adminErrorMessage(error);
      }
    });

    void loadThemeSettings().catch((error) => {
      themeStatusLabel.textContent = adminErrorMessage(error);
    });

    const siteIconFileInput = requireAdminElement("#site-icon-file", HTMLInputElement);
    const siteIconPreviewImg = requireAdminElement("#site-icon-preview", HTMLImageElement);
    const siteIconStatusLabel = requireAdminElement("#site-icon-status", HTMLElement);
    const refreshSiteIconPreview = () => {
      siteIconPreviewImg.src = "/site-icon/icon-512.png?v=" + Date.now();
    };

    requireAdminElement("#site-icon-upload", HTMLButtonElement).addEventListener("click", async () => {
      const file = siteIconFileInput.files?.[0];
      if (!file) {
        siteIconStatusLabel.textContent = "请先选择图片文件。";
        return;
      }
      siteIconStatusLabel.textContent = "上传中...";
      try {
        const response = await fetch("/admin-api/site-icon", {
          method: "POST",
          headers: { "content-type": file.type || "application/octet-stream", "x-nkustudy-admin-request": "1" },
          credentials: "same-origin",
          body: file,
