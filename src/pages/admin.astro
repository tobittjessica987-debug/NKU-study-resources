    function renderDonateRecords() {
      const current = donateState;
      if (!current) return;
      if (!donateRecordsEditor) return;
      if (!Array.isArray(current.records)) current.records = [];
      const records = current.records;
      donateRecordsEditor.innerHTML = "";
      const ensure = (row: AdminTypes.DonationRecord) => {
        if (!row || typeof row !== "object") return { date: "", nickname: "", usage: "" };
        return row;
      };
      current.records.forEach((rawRow, index) => {
        const row = ensure(rawRow);
        const line = document.createElement("div");
        line.className = "filter-row";
        line.style.marginBottom = "8px";
        const make = (value: string | undefined, placeholder: string, onInput: (value: string) => void) => {
          const input = document.createElement("input");
          input.className = "searchbar";
          input.style.minHeight = "36px";
          input.value = String(value ?? "");
          input.placeholder = placeholder;
          input.addEventListener("input", () => onInput(input.value));
          return input;
        };
        const dateInput = make(row.date, "2026-09-22", (value) => { row.date = value.slice(0, 10); });
        dateInput.style.maxWidth = "140px";
        const nickInput = make(row.nickname, "昵称（空=好心人）", (value) => { row.nickname = value.slice(0, 32); });
        nickInput.style.maxWidth = "160px";
        const usageInput = make(row.usage, "去向（初始待定）", (value) => { row.usage = value.slice(0, 40); });
        const del = document.createElement("button");
        del.type = "button";
        del.className = "button secondary";
        del.textContent = "删除";
        if (row.order_key) {
          del.disabled = true;
          del.title = "付款记录需保留准确归属，以便处理账号注销。";
        }
        del.addEventListener("click", () => {
          records.splice(index, 1);
          renderDonateRecords();
        });
        line.append(dateInput, nickInput, usageInput, del);
        donateRecordsEditor.append(line);
      });
      const add = document.createElement("button");
      add.type = "button";
      add.className = "button secondary";
      add.textContent = "添加记录";
      add.addEventListener("click", () => {
        records.push({ date: "", nickname: "", usage: "" });
        renderDonateRecords();
      });
      donateRecordsEditor.append(add);
    }

    let donateStatsRows: AdminTypes.DonationOrder[] = [];
    let donateStatsPage = 1;
    const DONATE_STATS_PAGE_SIZE = 50;

    async function loadDonateStats() {
      const status = findAdminElement("#donate-stats-message", HTMLElement);
      if (status) status.textContent = "加载中...";
      try {
        const data = await api("/donate-stats");
        donateOrderSummaryCache = data.data.summary;
        donateStatsRows = data.data.recent || [];
        donateStatsPage = 1;
        renderDonateStats(donateOrderSummaryCache);
        if (status) status.textContent = "";
      } catch (error) {
        if (status) status.textContent = adminErrorMessage(error);
      }
    }

    function donateStatsFiltered() {
      const keyword = String(findAdminElement("#donate-stats-search", HTMLInputElement)?.value || "").trim().toLowerCase();
      const statusFilter = findAdminElement("#donate-stats-status", HTMLSelectElement)?.value || "all";
      const sourceFilter = findAdminElement("#donate-stats-source", HTMLSelectElement)?.value || "all";
      return donateStatsRows.filter((row) => {
        if (statusFilter !== "all" && row.status !== statusFilter) return false;
        if (sourceFilter !== "all" && (row.source || "") !== sourceFilter) return false;
        if (!keyword) return true;
        const date = new Date(Number(row.created_at) + 8 * 3600 * 1000).toISOString().slice(0, 10);
        return [row.out_trade_no, row.transaction_id, row.nickname, row.remark, String(date), String(row.amount_total / 100)]
          .map((value) => String(value || "").toLowerCase())
          .some((value) => value.includes(keyword));
      });
    }

    function renderDonateStats(summary?: AdminTypes.DonationSummary | null) {
      const yuan = (fen: number) => (fen / 100).toFixed(2);
      const sourceLabel: Record<string, string> = { jsapi: "小程序", native: "网页扫码" };
      const s = summary || donateOrderSummaryCache;
      const filtered = donateStatsFiltered();
      const pages = Math.max(1, Math.ceil(filtered.length / DONATE_STATS_PAGE_SIZE));
      if (donateStatsPage > pages) donateStatsPage = pages;
      const slice = filtered.slice((donateStatsPage - 1) * DONATE_STATS_PAGE_SIZE, donateStatsPage * DONATE_STATS_PAGE_SIZE);
      const rows = slice.map((row) => {
        const date = new Date(Number(row.created_at) + 8 * 3600 * 1000).toISOString().slice(0, 10);
        const esc = (value: unknown) => String(value || "").replace(/[<>&"]/g, "");
        return `<tr><td>${date}</td><td>¥${yuan(row.amount_total)}</td><td>${sourceLabel[row.source] || row.source || "-"}</td><td>${esc(row.nickname) || "-"}</td><td>${esc(row.remark) || "-"}</td><td>${row.status === "paid" ? "已支付" : "待支付"}</td><td class="muted" style="font-size:12px;">${esc(row.out_trade_no)}</td></tr>`;
      }).join("");
      if (s) {
        const sources = Object.entries(s.by_source).map(([key, value]) => `${sourceLabel[key] || key} ${value.count} 笔 / ¥${yuan(value.total_fen)}`).join("，") || "暂无";
        donateStatsBody.innerHTML = `
          <p style="margin:0 0 8px;"><b>累计入账 ${s.paid_count} 笔 / ¥${yuan(s.paid_total_fen)}</b>（${sources}；待支付 ${s.pending_count} 笔）</p>
          <table class="admin-table" style="margin-top:8px;"><thead><tr><th>日期</th><th>金额</th><th>来源</th><th>昵称</th><th>备注</th><th>状态</th><th>订单号</th></tr></thead><tbody>${rows || '<tr><td colspan="7" class="muted">没有匹配的订单</td></tr>'}</tbody></table>
        `;
      }
      const pager = findAdminElement("#donate-stats-pager", HTMLElement);
      if (pager) {
        pager.innerHTML = "";
        const prev = document.createElement("button");
        prev.type = "button";
        prev.className = "button secondary";
        prev.textContent = "上一页";
        prev.disabled = donateStatsPage <= 1;
        prev.addEventListener("click", () => { donateStatsPage -= 1; renderDonateStats(); });
        const next = document.createElement("button");
        next.type = "button";
        next.className = "button secondary";
        next.textContent = "下一页";
        next.disabled = donateStatsPage >= pages;
        next.addEventListener("click", () => { donateStatsPage += 1; renderDonateStats(); });
        const label = document.createElement("span");
        label.className = "muted";
        label.textContent = `第 ${donateStatsPage} / ${pages} 页，筛选后 ${filtered.length} 笔（共 ${donateStatsRows.length} 笔）`;
        pager.append(prev, label, next);
      }
    }

