    const batchTagsList = requireAdminElement("#batch-tags-list", HTMLElement);
    const batchTagsSelection = new Set<string>();

    function renderBatchTagList() {
      const keyword = batchTagsFilter.value.trim().toLowerCase();
      const courses = (state?.courses || []).filter((c) => {
        if (!keyword) return true;
        const text = `${c.title} ${c.term} ${c.group} ${(c.tags ?? []).join(" ")}`.toLowerCase();
        return text.includes(keyword);
      });
      batchTagsList.innerHTML = "";
      if (!courses.length) {
        batchTagsList.innerHTML = '<p class="empty">没有匹配的课程</p>';
        return;
      }
      for (const course of courses) {
        const row = document.createElement("label");
        row.className = "perm-check";
        row.style.cssText = "display:flex;align-items:center;gap:6px;padding:4px 0;border-bottom:1px solid var(--line);cursor:pointer;";
        const checked = batchTagsSelection.has(course.id);
        const tagText = (course.tags ?? []).slice(0, 5).join("、") || "无标签";
        row.innerHTML = `
          <input type="checkbox" data-course-id="${escapeHtml(course.id)}" ${checked ? "checked" : ""} />
          <b>${escapeHtml(course.title)}</b>
          <span class="muted" style="font-size:0.82em;">${escapeHtml(course.term)} · ${escapeHtml(course.group)}</span>
          <span class="muted" style="font-size:0.78em;margin-left:auto;">${escapeHtml(tagText)}</span>
        `;
        requireAdminElement("input", HTMLInputElement, row).addEventListener("change", (event) => {
          if (event.target instanceof HTMLInputElement && event.target.checked) batchTagsSelection.add(course.id);
          else batchTagsSelection.delete(course.id);
        });
        batchTagsList.append(row);
      }
    }

    function parseBatchTags() {
      return batchTagsInput.value.split(/[,，]/).map((t) => t.trim()).filter(Boolean).slice(0, 20);
    }

    async function runBatchTags(mode: "add" | "remove" | "rename") {
      const tags = parseBatchTags();
      const renameFromInput = findAdminElement("#batch-tags-rename-from", HTMLInputElement);
      const sourceTags = mode === "rename"
        ? (renameFromInput?.value || "").split(/[,，]/).map((t) => t.trim()).filter(Boolean).slice(0, 20)
        : [];
      if (!tags.length) { batchTagsStatus.textContent = mode === "rename" ? "请先在上方填写新标签" : "请先填写标签"; return; }
      if (mode === "rename" && !sourceTags.length) { batchTagsStatus.textContent = "请先填写要替换的原标签"; return; }
      if (!batchTagsSelection.size) { batchTagsStatus.textContent = "请先勾选课程"; return; }
      const affected = [];
      let touchedCount = 0;
      for (const course of loadedManifest().courses || []) {
        if (!batchTagsSelection.has(course.id)) continue;
        const current = new Set<string>(course.tags ?? []);
        if (mode === "add") {
          for (const t of tags) current.add(t);
          touchedCount += 1;
        } else if (mode === "remove") {
          for (const t of tags) current.delete(t);
          touchedCount += 1;
        } else {
          const present = sourceTags.filter((t) => current.has(t));
          if (!present.length) continue;
          for (const t of present) current.delete(t);
          for (const t of tags) current.add(t);
          touchedCount += 1;
        }
        course.tags = [...current].slice(0, 30);
        course.updated = new Date().toISOString().slice(0, 10);
        affected.push(course.title);
      }
      if (mode === "rename" && !touchedCount) {
        batchTagsStatus.textContent = `勾选的课程都没有标签「${sourceTags.join("、")}」，未做修改。`;
        return;
      }
      const actionLabel = mode === "add" ? "添加" : mode === "remove" ? "移除" : `把「${sourceTags.join("、")}」改成`;
      batchTagsStatus.textContent = `已${actionLabel} ${tags.join("、")} → ${touchedCount} 门课程，正在发布…`;
      try {
        const data = await api("/manifest", {
          method: "POST",
          body: JSON.stringify(manifestWriteBody()),
        });
        acceptManifest(data);
        renderTree();
        renderEditor();
        renderBatchTagList();
        const doneLabel = mode === "rename"
          ? `已完成：${touchedCount}/${batchTagsSelection.size} 门课程把「${sourceTags.join("、")}」改成「${tags.join("、")}」并发布。`
          : `已完成：${touchedCount} 门课程已${mode === "add" ? "添加" : "移除"}标签「${tags.join("、")}」并发布。`;
        batchTagsStatus.textContent = doneLabel;
      } catch (error) {
        batchTagsStatus.textContent = `发布失败：${adminErrorMessage(error)}`;
      }
    }

