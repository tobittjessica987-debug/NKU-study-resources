    function lawPager(page: LawPagination, onPage: (page: number) => void) {
      const pager = lawNode("div", "", "filter-row law-pager");
      const previous = document.createElement("button");
      previous.type = "button";
      previous.className = "button secondary";
      previous.textContent = "上一页";
      previous.disabled = page.page <= 1;
      previous.addEventListener("click", () => onPage(page.page - 1));
      const next = document.createElement("button");
      next.type = "button";
      next.className = "button secondary";
      next.textContent = "下一页";
      next.disabled = !page.has_more;
      next.addEventListener("click", () => onPage(page.page + 1));
      pager.append(previous, lawNode("span", `第 ${page.page} / ${Math.max(1, page.total_pages)} 页 · 共 ${page.total} 条 · 本页 ${page.returned} 条${page.has_more ? " · 还有更多" : ""}`, "muted"), next);
      return pager;
    }

