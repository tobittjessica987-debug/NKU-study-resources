        timeZone: "Asia/Shanghai",
        year: "numeric",
        month: "2-digit",
        day: "2-digit",
      }).format(value);
    }

    function beijingDateTime(value: string | number | Date | null | undefined) {
      if (!value) return "";
      const date = new Date(value);
      if (Number.isNaN(date.getTime())) return String(value);
      return new Intl.DateTimeFormat("zh-CN", {
        timeZone: "Asia/Shanghai",
        year: "numeric",
        month: "2-digit",
        day: "2-digit",
        hour: "2-digit",
        minute: "2-digit",
        second: "2-digit",
        hour12: false,
      }).format(date);
    }

    function api(path: "/service-keys", options: RequestInit & { method: "POST" }): Promise<AdminTypes.DataResponse<AdminTypes.ServiceKey & { key: string }>>;
    function api(path: "/accounts", options: RequestInit & { method: "POST" }): Promise<AdminTypes.DataResponse<AdminTypes.AdminAccount>>;
    function api<Path extends string>(path: Path, options?: RequestInit): Promise<AdminApiResult<Path>>;
    async function api(path: string, options: RequestInit = {}): Promise<AdminTypes.AdminActionResponse> {
      const response = await fetch(`/admin-api${path}`, {
        ...options,
        headers: {
          "content-type": "application/json",
          "x-nkustudy-admin-request": "1",
          ...(options.headers || {}),
        },
      });
      let data: AdminTypes.AdminActionResponse & { currentRevision?: string };
      try {
        // Response DTOs mirror the corresponding admin-server endpoint contract.
        data = await response.json();
      } catch {
        throw Object.assign(new Error(`服务器返回异常（HTTP ${response.status}），请稍后重试；未保存草稿已保留。`), { status: response.status });
      }
      if (!response.ok || data.ok === false) {
        const error = Object.assign(new Error(data.error || data.errors?.join("\n") || "请求失败"), {
          status: response.status,
          currentRevision: data.currentRevision,
          responseData: data,
        });
        if (response.status === 409) error.message += "\n服务器内容已变化，本次没有覆盖。草稿已保留，请选择如何处理冲突。";
        if (response.status === 401) {
          error.message = "登录已过期，请重新登录。";
          showSessionExpired();
        }
        throw error;
      }
      return data;
    }

