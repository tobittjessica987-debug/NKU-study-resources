    async function deleteR2Paths(course: AdminTypes.AdminCourse, paths: string[]) {
      const cleanPaths = paths.filter(Boolean);
      if (!cleanPaths.length) return {};
      const candidate = structuredClone(loadedManifest());
      const target = candidate.courses.find((item) => item.uid === course.uid);
      const deleting = new Set(cleanPaths);
      for (const section of target?.sections || []) {
        section.files = (section.files || []).filter((file) => !deleting.has(file.path));
      }
      const data = await api("/r2-publish", {
        method: "POST",
        body: JSON.stringify(manifestWriteBodyFor(candidate, {
          fileDeletes: [{ courseUid: requireCourseUid(course), paths: cleanPaths }],
          moves: changedCourseDirectories(),
        })),
      });
      acceptManifest(data);
      return data;
    }

    async function deleteCourse(course: AdminTypes.AdminCourse) {
      if (!confirm("删除课程「" + (course.title || "") + "」？课程记录、资源板块和 R2 中 " + (course.basePath || "") + " 下的文件都会删除。")) return;
      publishStatus.textContent = "正在删除课程...";
      const candidate = structuredClone(loadedManifest());
      candidate.courses = candidate.courses.filter((item) => item.uid !== course.uid);
      const data = await api("/r2-publish", {
        method: "POST",
        body: JSON.stringify(manifestWriteBodyFor(candidate, {
          moves: changedCourseDirectories().filter((move) => move.courseUid !== course.uid),
        })),
      });
      acceptManifest(data);
      selectedId = loadedManifest().courses[0]?.id ?? null;
      renderTree();
      renderEditor();
      publishStatus.textContent = statusWithWarnings("课程已删除并发布", data);
    }

    function changedCourseDirectories(): AdminTypes.DirectoryMove[] {
      const moves: AdminTypes.DirectoryMove[] = [];
      const directoryPath = (basePath: string) => String(basePath || "").replace(/\/+$/, "");
      for (const course of loadedManifest().courses) {
        const oldBasePath = originalCourseBasePaths.get(course);
        if (!oldBasePath || oldBasePath === course.basePath || !course.uid) continue;
        moves.push({
          courseUid: course.uid,
          oldBasePath: directoryPath(oldBasePath),
          newBasePath: directoryPath(course.basePath),
        });
      }
      return moves;
    }

