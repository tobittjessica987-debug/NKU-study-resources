      originalCourseHashes = new Map(loadedManifest().courses.map((course) => [course.id, courseHash(course)]));
      originalCourseBasePaths = new WeakMap();
      loadedManifest().courses.forEach((course) => originalCourseBasePaths.set(course, course.basePath));
