    function manifestWriteBodyFor(manifest: AdminTypes.AdminManifest, extra: AdminTypes.ManifestWriteExtra = {}) {
      const currentUids = new Set(manifest.courses.map((course) => course.uid).filter((uid): uid is string => Boolean(uid)));
      return {
        manifest,
        expectedRevision: manifestRevision,
        deletedCourseUids: [...originalCourseUids].filter((uid) => !currentUids.has(uid)),
        ...extra,
      };
    }

    function acceptManifest(data: AdminTypes.ManifestResponse) {
      state = data.manifest;
