        field("更新时间", course.updated, (value) => { course.updated = value; }),
        field("贡献者，逗号分隔", (course.contributors ?? []).join(", "), (value) => {
          course.contributors = value.split(",").map((name) => name.trim()).filter(Boolean);
        }),
        basePathField,
        markdownField("简介（支持 Markdown）", course.summary, (value) => { course.summary = value; }),
        field("标签，逗号分隔", (course.tags ?? []).join(", "), (value) => {
          course.tags = value.split(",").map((tag) => tag.trim()).filter(Boolean);
        }),
        field("本课程额外隐藏标签，逗号分隔", (course.hiddenMetaTags ?? []).join(", "), (value) => {
          course.hiddenMetaTags = value.split(",").map((tag) => tag.trim()).filter(Boolean);
        })
      );

      const courseActions = document.createElement("div");
      courseActions.className = "filter-row";
      const deleteCourseButton = document.createElement("button");
      deleteCourseButton.type = "button";
      deleteCourseButton.className = "button secondary";
      deleteCourseButton.textContent = "删除课程";
      deleteCourseButton.addEventListener("click", async () => {
        deleteCourseButton.disabled = true;
        try {
          await deleteCourse(course);
        } catch (error) {
          alert(adminErrorMessage(error));
          publishStatus.textContent = adminErrorMessage(error);
          deleteCourseButton.disabled = false;
        }
      });
      courseActions.append(deleteCourseButton);
      form.append(courseActions);

      const sections = document.createElement("div");
      sections.className = "section-stack";
      sections.style.marginTop = "18px";

      course.sections.forEach((section, sectionIndex) => {
        const details = document.createElement("details");
        details.className = "resource-section";
        details.open = true;
        const sectionFiles = groupedSectionFiles(section);
        details.innerHTML = "<summary>" + escapeHtml(section.title || "未命名板块") + ' <span class="muted">(' + sectionFiles.visible.length + ")</span></summary>";

        const body = document.createElement("div");
        body.className = "admin-section-body";
        const sectionActions = document.createElement("div");
        sectionActions.className = "filter-row";
        const moveUp = document.createElement("button");
        moveUp.type = "button";
        moveUp.className = "button secondary";
        moveUp.textContent = "上移";
        moveUp.disabled = sectionIndex === 0;
        moveUp.addEventListener("click", () => {
          if (sectionIndex <= 0) return;
          const list = course.sections;
          [list[sectionIndex - 1], list[sectionIndex]] = [list[sectionIndex], list[sectionIndex - 1]];
          renderEditor();
        });
        const moveDown = document.createElement("button");
        moveDown.type = "button";
        moveDown.className = "button secondary";
        moveDown.textContent = "下移";
        moveDown.disabled = sectionIndex === course.sections.length - 1;
        moveDown.addEventListener("click", () => {
          if (sectionIndex >= course.sections.length - 1) return;
          const list = course.sections;
          [list[sectionIndex + 1], list[sectionIndex]] = [list[sectionIndex], list[sectionIndex + 1]];
          renderEditor();
        });
        const removeSection = document.createElement("button");
        removeSection.type = "button";
        removeSection.className = "button secondary";
        removeSection.textContent = "删除板块";
        removeSection.addEventListener("click", async () => {
          if (!confirm("删除板块「" + (section.title || "") + "」？其中所有 R2 文件也会同步删除。")) return;
          removeSection.textContent = "删除中...";
          removeSection.disabled = true;
          try {
            const data = await deleteR2Paths(course, (section.files ?? []).map((file) => file.path));
            publishStatus.textContent = statusWithWarnings("板块已删除并发布", data);
          } catch (error) {
            alert(adminErrorMessage(error));
            removeSection.textContent = "删除板块";
            removeSection.disabled = false;
            return;
          }
          course.sections.splice(sectionIndex, 1);
          renderEditor();
        });
        const removeSelected = document.createElement("button");
        removeSelected.type = "button";
        removeSelected.className = "button secondary";
        removeSelected.textContent = "删除选中文件";
        removeSelected.addEventListener("click", async () => {
          const selected = (section.files ?? []).filter((file) => selectedAdminFiles.has(file));
          if (!selected.length) {
            alert("请先勾选要删除的文件。");
            return;
          }
          if (!confirm("删除选中的 " + selected.length + " 个文件？R2 中的对象也会同步删除。")) return;
          removeSelected.textContent = "删除中...";
          removeSelected.disabled = true;
          try {
            const data = await deleteR2Paths(course, selected.map((file) => file.path));
            publishStatus.textContent = statusWithWarnings("选中文件已删除并发布", data);
          } catch (error) {
            alert(adminErrorMessage(error));
            removeSelected.textContent = "删除选中文件";
            removeSelected.disabled = false;
            return;
          }
          section.files = (section.files ?? []).filter((file) => !selectedAdminFiles.has(file));
          selected.forEach((file) => selectedAdminFiles.delete(file));
          renderEditor();
        });
        sectionActions.append(moveUp, moveDown, removeSelected, removeSection);

        body.append(
          field("板块名", section.title, (value) => { section.title = value; renderEditor(); }),
          markdownField("板块说明（支持 Markdown）", section.note, (value) => { section.note = value; }, { height: 150 }),
          sectionActions,
          renderDropZone(course, section, sectionIndex)
        );

        const files = document.createElement("div");
        files.className = "admin-file-list";
        for (const group of sectionFiles.groups) {
          const subgroup = document.createElement("details");
          subgroup.className = "resource-subsection";
          subgroup.open = true;
          subgroup.innerHTML = "<summary>" + escapeHtml(group.title) + ' <span class="muted">(' + group.files.length + ")</span></summary>";
          const subgroupBody = document.createElement("div");
          subgroupBody.className = "admin-section-body";
          for (const file of group.files) {
            subgroupBody.append(renderFileRow(course, file, section.files));
          }
          subgroup.append(subgroupBody);
          files.append(subgroup);
        }
        for (const file of sectionFiles.direct) {
          files.append(renderFileRow(course, file, section.files));
        }

        const addFile = document.createElement("button");
        addFile.type = "button";
        addFile.className = "button secondary";
        addFile.textContent = "手动新增文件";
        addFile.addEventListener("click", () => {
          section.files ??= [];
          section.files.push({ title: "新文件.pdf", path: (section.title || "其他") + "/新文件.pdf", size: 0, description: "" });
          renderEditor();
        });

        body.append(files, addFile);
        details.append(body);
        sections.append(details);
      });

      const addSection = document.createElement("button");
      addSection.type = "button";
      addSection.className = "button secondary";
      addSection.textContent = "新增板块";
      addSection.addEventListener("click", () => {
        course.sections ??= [];
        course.sections.push({ title: "新板块", note: "", files: [] });
        renderEditor();
      });

      form.append(sections, addSection);
      editorEl.append(form);
      mountMarkdownEditors(editorEl);
    }

