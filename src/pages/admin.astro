function renderServiceKeysList() {
  const listEl = requireAdminElement("#service-keys-list", HTMLElement);
  listEl.innerHTML = "";
  if (!serviceKeysState.services.length) {
    listEl.innerHTML = '<p class="empty">还没有服务密钥。</p>';
    return;
  }
  for (const service of serviceKeysState.services) {
    const wrap = document.createElement("div");
    wrap.className = "review-admin-item";
    wrap.innerHTML = `
      <div class="course-meta">
        <span class="pill">${escapeHtml(service.name)}</span>
        <span class="pill">${escapeHtml(service.key_prefix)}…</span>
        <span class="pill">${service.enabled ? "启用中" : "已停用"}</span>
        <span class="pill">每日额度 ${Number(service.limits.daily_quota).toLocaleString("zh-CN")}</span>
        ${service.note ? `<span class="pill">${escapeHtml(service.note)}</span>` : ""}
      </div>
      <small class="muted">创建于 ${escapeHtml(service.created_at || "")}</small>
    `;
    const actions = document.createElement("div");
    actions.className = "filter-row";
    actions.style.marginTop = "8px";
    const quotaInput = document.createElement("input");
    quotaInput.type = "number";
    quotaInput.className = "searchbar";
    quotaInput.style.maxWidth = "180px";
    quotaInput.min = "1";
    quotaInput.value = String(service.limits.daily_quota);
    quotaInput.title = "每日调用额度";
    const saveQuota = document.createElement("button");
    saveQuota.type = "button";
    saveQuota.className = "button secondary";
    saveQuota.textContent = "保存额度";
    saveQuota.addEventListener("click", async () => {
      try {
        const data = await api(`/service-keys/${encodeURIComponent(service.id)}/daily-quota`, { method: "POST", body: JSON.stringify({ daily_quota: Number(quotaInput.value) }) });
        serviceKeysState.services = data.data.services;
        renderServiceKeysList();
        requireAdminElement("#service-key-status", HTMLElement).textContent = `已更新 ${service.name} 的每日额度。`;
      } catch (error) { requireAdminElement("#service-key-status", HTMLElement).textContent = adminErrorMessage(error); }
    });
    const toggle = document.createElement("button");
    toggle.type = "button";
    toggle.className = "button secondary";
    toggle.textContent = service.enabled ? "停用" : "启用";
    toggle.addEventListener("click", async () => {
      try {
        const data = await api(`/service-keys/${encodeURIComponent(service.id)}/enabled`, { method: "POST", body: JSON.stringify({ enabled: !service.enabled }) });
        serviceKeysState.services = data.data.services;
        renderServiceKeysList();
      } catch (error) { requireAdminElement("#service-key-status", HTMLElement).textContent = adminErrorMessage(error); }
    });
    const remove = document.createElement("button");
    remove.type = "button";
    remove.className = "button secondary";
    remove.textContent = "删除";
    remove.addEventListener("click", async () => {
      if (!confirm(`删除服务「${service.name}」？对应服务的所有调用会立即失效。`)) return;
      try {
        const data = await api(`/service-keys/${encodeURIComponent(service.id)}`, { method: "DELETE" });
        serviceKeysState.services = data.data.services;
        renderServiceKeysList();
      } catch (error) { requireAdminElement("#service-key-status", HTMLElement).textContent = adminErrorMessage(error); }
    });
    actions.append(quotaInput, saveQuota, toggle, remove);
    wrap.append(actions);
    listEl.append(wrap);
  }
}

