    function renderLawQueryState(view: LawQueryView) {
      const status = document.querySelector<HTMLElement>("#law-admin-status")!;
      const exportStatus = document.querySelector<HTMLElement>("#law-export-status")!;
      const box = document.querySelector<HTMLElement>("#law-result")!;
      document.querySelector<HTMLButtonElement>("#law-query-run")!.disabled = view.phase === "loading";
      document.querySelector<HTMLButtonElement>("#law-export-run")!.disabled = view.exportPhase === "loading";
      box.setAttribute("aria-busy", String(view.phase === "loading"));
      status.textContent = view.phase === "loading" ? "正在查询…" : view.error || (view.phase === "ready" ? "查询已返回。" : "");
      exportStatus.textContent = view.exportMessage;
      box.replaceChildren();
      if (view.phase !== "ready" || !view.data) {
        box.append(lawNode("p", view.phase === "loading" ? "正在加载本次查询结果…" : view.error || "输入账号或内容 ID 后查询。", "muted"));
        return;
      }
      const data = view.data;
      box.append(lawNode("p", `查询对象：${data.query.target} · 返回时间（北京）：${formatLawTime(data.generatedAt)}${data.query.reference ? ` · 关联编号：${data.query.reference}` : ""}`, "field-hint"));
      box.append(lawNode("p", `日志范围（北京，含端点）：${formatLawTime(data.range.from_ms)} 至 ${formatLawTime(data.range.to_ms)} · 安全日志操作：${data.query.filters.action || "全部"} · 管理员审计操作：${data.query.filters.audit_action || "全部"}`, "field-hint"));
      if (!data.complete) box.append(lawNode("p", "当前显示各类结果的一页，请分别翻页查看；完整 JSON 导出会包含当前日志筛选范围及全部关联内容。", "field-hint"));
      if (data.account) {
        const account = data.account;
        const card = lawNode("article", "", "card law-record");
        card.append(lawNode("h3", `账号 #${account.id} · ${account.nickname || "无昵称"}`));
        card.append(lawNode("p", `手机号：${account.phone || "未验证"} · 验证时间（北京）：${formatLawTime(account.phone_verified_at)} · 状态：${account.blocked ? "已封禁" : "正常"}`));
        card.append(lawNode("p", `注册（北京）：${formatLawTime(account.created_at)} · 最近登录（北京）：${formatLawTime(account.last_login_at)}`, "muted"));
        card.append(lawRecordDetails(account));
        box.append(card);
      } else box.append(lawNode("p", "没有关联账号（内容可能来自匿名提交或账号已不在当前库中）。", "muted"));
      for (const [key, paginationKey, title] of [
        ["reviews", "reviews_pagination", "关联评价"],
        ["feedback", "feedback_pagination", "关联反馈/举报"],
        ["security_logs", "log_pagination", "安全日志"],
        ["admin_audit", "audit_pagination", "管理员审计"],
      ] as const) {
        const section = lawNode("section", "", "law-result-section");
        section.setAttribute("aria-label", title);
        section.append(lawNode("h3", `${title}（共 ${data[paginationKey].total} 条）`));
        if (!data[key].length) section.append(lawNode("p", data[paginationKey].total ? "本页没有记录。" : "没有符合条件的记录。", "muted"));
        for (const record of data[key]) {
          const card = lawNode("article", "", "card law-record");
          if (key === "reviews") {
            card.append(lawNode("h4", `评价 ${record.id} · ${record.courseTitle || ""} · ${record.teacher || ""}`), lawNode("p", record.content || "", "law-record-body"));
          } else if (key === "feedback") {
            card.append(lawNode("h4", `反馈/举报 ${record.id} · ${record.type || ""} · ${record.title || ""}`), lawNode("p", record.content || "", "law-record-body"));
            if (record.report_url || record.report_target) card.append(lawNode("p", `关联：${record.report_url || ""} ${record.report_target || ""}`, "muted"));
          } else if (key === "security_logs") {
            card.append(lawNode("p", `${formatLawTime(record.at)}（北京） · ${record.action} · ${record.target_type || ""}:${record.target_id || ""} · ${record.result || ""}`));
            card.append(lawNode("p", `账号：${record.user_id ?? "—"} · IP：${record.ip || "—"}`, "muted"));
          } else {
            card.append(lawNode("p", `${formatLawTime(record.at)}（北京） · ${record.username || "—"} · ${record.action || "—"} · HTTP ${record.status ?? "—"}`));
            card.append(lawNode("p", `对象：${record.target || "—"} · IP：${record.ip || "—"}`, "muted"));
          }
          card.append(lawRecordDetails(record));
          section.append(card);
        }
        section.append(lawPager(data[paginationKey], (page) => { void lawQueryController.page(key, page).then((ok) => { if (ok) void loadLawLogs(); }); }));
        box.append(section);
      }
    }

    function renderLawLogsState(view: LawLogView) {
      const box = document.querySelector<HTMLElement>("#law-logs")!;
