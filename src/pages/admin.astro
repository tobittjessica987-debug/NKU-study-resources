    const courseBasePath = (course: AdminTypes.AdminCourse) => {
      const parts = [course.term, course.group, course.title]
        .map((part) => String(part ?? "").trim())
        .filter(Boolean);
      return `${parts.join("/")}/`;
    };

    function syncCourseBasePath(course: AdminTypes.AdminCourse) {
      course.basePath = courseBasePath(course);
    }

    function isOpenListPlaceholder(file: AdminTypes.AdminFile) {
      const text = `${file?.title ?? ""}/${file?.path ?? ""}`.toLowerCase();
      return text.includes(".openlist");
    }

    function filePathParts(section: AdminTypes.AdminSection, file: AdminTypes.AdminFile) {
      const parts = String(file?.path || file?.title || "").split("/").filter(Boolean);
      if (parts[0] === section.title) parts.shift();
      return parts;
    }

    function groupedSectionFiles(section: AdminTypes.AdminSection) {
      const visible = (section.files ?? []).filter((file) => !isOpenListPlaceholder(file));
      const direct = [];
      const groups = new Map<string, AdminTypes.AdminFile[]>();
      for (const file of visible) {
        const parts = filePathParts(section, file);
        if (parts.length > 1) {
          const groupName = parts[0];
          const files = groups.get(groupName) ?? [];
          if (!groups.has(groupName)) groups.set(groupName, files);
          files.push(file);
        } else {
          direct.push(file);
        }
      }
      return {
        visible,
        direct,
        groups: Array.from(groups, ([title, files]) => ({ title, files })),
      };
    }

    const sectionRank = (title = "") => {
      const lower = title.toLowerCase();
      if (title.includes("大纲") || title.includes("说明")) return 0;
      if (title.includes("真题") || title.includes("试题") || title.includes("试卷")) return 1;
      if (lower.includes("ppt") || title.includes("课件")) return 2;
      return 3;
    };

