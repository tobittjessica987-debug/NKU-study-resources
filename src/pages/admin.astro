    requireAdminElement("#run-backup-now", HTMLButtonElement).addEventListener("click", async () => {
      if (!manualBackupParts.siteData && !manualBackupParts.courseFiles) {
        alert("请至少选择「站点数据」或「课程文件」其中一项。");
        return;
      }
      const chosen = [
        manualBackupParts.siteData ? "站点数据" : null,
        manualBackupParts.courseFiles ? "课程文件（增量）" : null,
      ].filter(Boolean).join(" + ");
      if (!confirm("按本次选择立即备份：" + chosen + "（服务器配置仅在站点数据快照内体现）。备份开始时会短暂暂停新请求，课程文件较多时首次可能需要等待，之后仅同步有变化的对象。")) return;
      backupAdminStatus.textContent = "备份执行中...";
      try {
        const result = await api("/backup-run", { method: "POST", body: JSON.stringify({ parts: { ...manualBackupParts } }) }) as AdminTypes.AdminActionResponse & {
          complete?: boolean; local?: { filename: string };
          webdav?: { verified: boolean; courseFiles?: { total: number; uploaded: number; skipped: number } }[];
          r2?: { verified: boolean }[];
        };
        const courseStats = (result.webdav || []).reduce((acc: { uploaded: number; skipped: number; total: number }, item) => {
          const stats: { total?: number; uploaded?: number; skipped?: number } = item.courseFiles || {};
          acc.uploaded += stats.uploaded || 0;
          acc.skipped += stats.skipped || 0;
          acc.total += stats.total || 0;
          return acc;
        }, { uploaded: 0, skipped: 0, total: 0 });
        const verified = (result.webdav || []).filter((item) => item.verified).length + (result.r2 || []).filter((item) => item.verified).length;
        const courseSummary = courseStats.total ? "课程文件：本次上传 " + courseStats.uploaded + " 个，跳过未变化 " + courseStats.skipped + " 个（共 " + courseStats.total + " 个）。" : "";
        backupAdminStatus.textContent = result.complete ? "备份完成。" + (result.local ? "本地加密备份已校验，另有 " + verified + " 个远端副本通过读回校验。" : "") + courseSummary : "备份未完整完成，请联系维护者核对失败项。" + courseSummary;
      } catch (error) {
