    function selectedCourse() {
      return state?.courses.find((item) => item.id === selectedId);
    }

    const TREE_COLLAPSE_STORAGE_KEY = "nkustudy-admin-tree-collapsed-nodes";
    const TERM_ORDER = ["大一上", "大一下", "大二上", "大二下", "大三上", "大三下", "大四上", "大四下"];

    function termRank(term: string) {
      if (term === "E课") return 2000;
      const normalized = String(term || "").replace(/\s+/g, "");
      const index = TERM_ORDER.indexOf(normalized);
      if (index >= 0) return index;
      return 1000;
    }

    function readCollapsedTreeNodes(): Set<string> {
      try {
        const raw = JSON.parse(localStorage.getItem(TREE_COLLAPSE_STORAGE_KEY) || "[]");
        return new Set(Array.isArray(raw) ? raw.map(String) : []);
      } catch {
        return new Set();
      }
    }

    function writeCollapsedTreeNodes(nodes: Set<string>) {
      localStorage.setItem(TREE_COLLAPSE_STORAGE_KEY, JSON.stringify([...nodes]));
    }

    const collapsedTreeNodes = readCollapsedTreeNodes();
    treeEl.addEventListener("toggle", (event) => {
      const target = event.target as HTMLDetailsElement | null;
      if (!target || !(target instanceof HTMLDetailsElement) || !target.dataset.collapseKey) return;
      if (target.open) collapsedTreeNodes.delete(target.dataset.collapseKey);
      else collapsedTreeNodes.add(target.dataset.collapseKey);
      writeCollapsedTreeNodes(collapsedTreeNodes);
    }, true);

    function localeCompareText(a: string | null | undefined, b: string | null | undefined) {
      return String(a ?? "").localeCompare(String(b ?? ""), "zh-Hans-CN");
    }

    function renderTree() {
      const keyword = searchEl.value.trim().toLowerCase();
      treeEl.innerHTML = "";
      const terms = new Map<string, Map<string, AdminTypes.AdminCourse[]>>();

      for (const course of loadedManifest().courses) {
        const text = `${course.title} ${course.term} ${course.group} ${(course.tags ?? []).join(" ")}`.toLowerCase();
        if (keyword && !text.includes(keyword)) continue;
        const groups = terms.get(course.term) ?? new Map<string, AdminTypes.AdminCourse[]>();
        if (!terms.has(course.term)) terms.set(course.term, groups);
        const courses = groups.get(course.group) ?? [];
        if (!groups.has(course.group)) groups.set(course.group, courses);
        courses.push(course);
      }

      const sortedTerms = [...terms.keys()].sort((a, b) => termRank(a) - termRank(b) || localeCompareText(a, b));
      for (const term of sortedTerms) {
        const groups = terms.get(term)!;
        const termDetails = document.createElement("details");
        termDetails.className = "admin-tree-node";
        termDetails.dataset.collapseKey = `term:${term}`;
        termDetails.open = !collapsedTreeNodes.has(termDetails.dataset.collapseKey);
        termDetails.innerHTML = `<summary>${escapeHtml(term || "未设置学期")}</summary>`;

        const sortedGroups = [...groups.keys()].sort(localeCompareText);
        for (const group of sortedGroups) {
          const groupDetails = document.createElement("details");
          groupDetails.className = "admin-tree-node admin-tree-group";
          groupDetails.dataset.collapseKey = `group:${term}/${group}`;
          groupDetails.open = !collapsedTreeNodes.has(groupDetails.dataset.collapseKey);
          groupDetails.innerHTML = `<summary>${escapeHtml(group || "未设置分类")}</summary>`;

          const sortedCourses = [...groups.get(group)!].sort((a, b) => localeCompareText(a.title, b.title));
          for (const course of sortedCourses) {
            const button = document.createElement("button");
            button.type = "button";
            button.className = "admin-tree-course";
            button.dataset.active = course.id === selectedId ? "true" : "false";
            button.innerHTML = `
              <strong>${escapeHtml(course.title || "未命名课程")}</strong>
              <small>${escapeHtml(course.updated || "")}</small>
            `;
            button.addEventListener("click", () => {
              selectedId = course.id;
              renderTree();
              renderEditor();
            });
            groupDetails.append(button);
          }
          termDetails.append(groupDetails);
        }
        treeEl.append(termDetails);
      }
    }

    function setTreeWidth(width: number) {
      const next = Math.min(620, Math.max(220, width));
      workbench.style.setProperty("--tree-width", `${next}px`);
      localStorage.setItem("nkustudy-admin-tree-width", String(next));
    }

    function restoreWorkbench() {
      const width = Number(localStorage.getItem("nkustudy-admin-tree-width"));
      if (width) setTreeWidth(width);
      if (localStorage.getItem("nkustudy-admin-tree-collapsed") === "true") {
        workbench.dataset.collapsed = "true";
        collapseTreeButton.textContent = "›";
        collapseTreeButton.title = "展开左侧";
      }
    }

    function field(label: string, value: string | number | null | undefined, onInput: (value: string, input: HTMLInputElement | HTMLTextAreaElement) => void, textarea = false) {
      const wrap = document.createElement("label");
      wrap.className = "admin-field";
      const labelEl = document.createElement("span");
      labelEl.textContent = label;
      const input = document.createElement(textarea ? "textarea" : "input");
      input.value = String(value ?? "");
      input.addEventListener("input", () => onInput(input.value, input));
      wrap.append(labelEl, input);
      return wrap;
    }

    let markdownEditors: { editor: Vditor; node: MarkdownEditorNode }[] = [];
    let markdownLabelSequence = 0;

    function destroyMarkdownEditors(root: Element | null = null) {
      const remaining: typeof markdownEditors = [];
      for (const entry of markdownEditors) {
        const node = entry?.node;
        const stale = !node?.isConnected || (root && root.contains(node));
        if (stale) {
          try {
            entry.editor?.destroy?.();
          } catch {}
          if (node) delete node.dataset.markdownMounted;
        } else {
          remaining.push(entry);
        }
      }
      markdownEditors = remaining;
    }

    function markdownField(label: string, value: string | undefined, onInput: (value: string, input?: HTMLTextAreaElement) => void, options: AdminTypes.MarkdownFieldOptions = {}) {
      const markdownValue = String(value ?? "");
      const wrap = document.createElement("div");
      wrap.className = "admin-field admin-markdown-field";
      const labelEl = document.createElement("span");
      labelEl.textContent = label;
      labelEl.id = `admin-markdown-label-${++markdownLabelSequence}`;
      const shell = document.createElement("div");
      shell.className = "markdown-shell";
      const fallback = document.createElement("textarea");
      fallback.className = "markdown-fallback";
      fallback.value = markdownValue;
      fallback.setAttribute("aria-labelledby", labelEl.id);
      fallback.style.minHeight = `${Number(options.height ?? 320)}px`;
      const editor = document.createElement("div") as MarkdownEditorNode;
      editor.className = "markdown-editor";
      editor.dataset.markdownEditor = "true";
      editor.dataset.markdownValue = markdownValue;
      editor.dataset.markdownHeight = String(options.height ?? 320);
      editor.dataset.markdownPlaceholder = options.placeholder ?? "";
      editor.dataset.markdownMode = options.mode ?? "sv";
      editor.setAttribute("aria-labelledby", labelEl.id);
      if (options.owner) editor.dataset.contentOwner = options.owner;
      editor.__markdownOnInput = onInput;
      fallback.addEventListener("input", () => onInput(fallback.value, fallback));
      shell.append(fallback, editor);
      wrap.append(labelEl, shell);
      return wrap;
    }

    function toolbarFor(mode: "admin" | "user") {
      const source = editorSettingsState?.[mode]?.toolbar;
      const toolbar = Array.isArray(source) && source.length
        ? source
        : (mode === "admin" ? defaultAdminToolbar : defaultUserToolbar);
      const firstSafe = ["bold", "italic", "strike", "link", "list", "ordered-list", "check"];
      return [
        ...firstSafe.filter((item) => toolbar.includes(item)),
        ...toolbar.filter((item) => !firstSafe.includes(item)),
      ];
    }

    function enhanceVditorToolbar(root: AdminTypes.MarkdownToolbarRoot) {
      const toolbarNodes = () => Array.from(adminElements(".vditor-toolbar button, .vditor-toolbar [data-type], .vditor-toolbar__item", HTMLElement, root));
      const blurToolbar = () => toolbarNodes().forEach((button) => button.blur?.());
      const applyTitles = () => {
        toolbarNodes().forEach((button) => {
          const type = button.dataset?.type || "";
          const label = toolbarItemLabel(type) || button.getAttribute("aria-label") || button.title;
          if (label) {
            button.title = label;
            button.setAttribute("aria-label", label);
            button.setAttribute("data-tooltip", label);
            button.closest(".vditor-toolbar__item")?.setAttribute("title", label);
            button.closest(".vditor-toolbar__item")?.setAttribute("aria-label", label);
          }
          button.tabIndex = -1;
          if (!button.dataset.nkustudyToolbarBound) {
            button.dataset.nkustudyToolbarBound = "true";
            button.addEventListener("focus", () => window.setTimeout(() => button.blur(), 0));
            button.addEventListener("mousedown", () => window.setTimeout(() => button.blur(), 0));
          }
        });
      };
      applyTitles();
      requestAnimationFrame(applyTitles);
      window.setTimeout(applyTitles, 80);
      if (!root.__nkustudyToolbarObserver) {
        root.__nkustudyToolbarObserver = new MutationObserver(applyTitles);
        root.__nkustudyToolbarObserver.observe(root, { childList: true, subtree: true });
      }
      root.addEventListener("pointerdown", (event) => {
        if (!(event.target instanceof Element) || !event.target.closest(".vditor-toolbar")) window.setTimeout(blurToolbar, 0);
      });
    }

    async function uploadContentImage(owner: string, file: File) {
      const form = new FormData();
      form.append("file", file);
      const response = await fetch(`/admin-api/content-images?owner=${encodeURIComponent(owner)}`, {
        method: "POST",
        headers: { "x-nkustudy-admin-request": "1" },
        body: form,
      });
      const data = await response.json();
      if (!response.ok || !data.ok) throw new Error(data.error || "图片上传失败");
      return data.data.url;
    }

    function contentImageUploadConfig(node: MarkdownEditorNode) {
      const owner = node.dataset.contentOwner;
      if (!owner) return {};
      return {
        upload: {
          url: `/admin-api/content-images?owner=${encodeURIComponent(owner)}`,
          accept: "image/png, image/jpeg, image/webp, image/gif",
          multiple: false,
          fieldName: "file",
          max: 8 * 1024 * 1024,
          headers: { "x-nkustudy-admin-request": "1" },
          // 服务端返回 {ok,data:{url}}；提供 success 时 vditor 跳过自身的 succMap 解析，由这里直接插入
          success(_editorElement: HTMLElement, responseText: string) {
            try {
              const parsed = JSON.parse(responseText);
              if (parsed?.ok && parsed.data?.url) {
                document.execCommand("insertHTML", false, `
![](${parsed.data.url})
`);
                return;
              }
              alert(parsed?.error || "图片上传失败");
            } catch {
              alert("图片上传失败");
            }
          },
        },
        extraToolbar: [{
          hotkey: "",
          name: "insert-image",
          tipPosition: "s",
          tip: "插入图片",
          className: "vditor-toolbar__item--insert-image",
          click() {
            const input = document.createElement("input");
            input.type = "file";
            input.accept = "image/png, image/jpeg, image/webp, image/gif";
            input.onchange = async () => {
              const file = input.files?.[0];
              if (!file) return;
              try {
                const url = await uploadContentImage(owner, file);
                node.__markdownEditorRef?.insertValue(`
![](${url})
`);
              } catch (error) {
                alert(adminErrorMessage(error) || "图片上传失败");
              }
            };
            input.click();
          },
        }],
      };
    }

    function mountMarkdownEditors(root: Element | null, mode: "admin" | "user" = "admin", { destroy = true } = {}) {
      if (destroy) destroyMarkdownEditors(root);
      const editors = Array.from(root?.querySelectorAll<MarkdownEditorNode>("[data-markdown-editor]") ?? []);
      for (const node of editors) {
        if (node.dataset.markdownMounted === "1") continue;
        // 折叠/隐藏的编辑表单不预挂载，等展开时再挂，避免搜索过滤时批量重建编辑器
        if (node.closest("[hidden], details:not([open])")) continue;
        const shell = node.closest(".markdown-shell");
        const fallback = shell?.querySelector<HTMLTextAreaElement>(".markdown-fallback");
        const imageSupport = contentImageUploadConfig(node);
        try {
          let editor: Vditor | undefined;
          let ready = false;
          editor = new Vditor(node, {
            mode: (node.dataset.markdownMode || "sv") as ReturnType<Vditor["getCurrentMode"]>,
            value: node.dataset.markdownValue ?? "",
            height: Number(node.dataset.markdownHeight || 320),
            placeholder: node.dataset.markdownPlaceholder || "",
            cache: { enable: false },
            toolbar: [...toolbarFor(mode), ...(imageSupport.extraToolbar || [])],
            toolbarConfig: { pin: false },
            ...(imageSupport.upload ? { upload: imageSupport.upload } : {}),
            preview: {
              actions: ["desktop", "tablet", "mobile"],
              markdown: {
                breaks: true,
              } as IMarkdownConfig & { breaks: boolean },
            },
            after() {
              if (!node.isConnected) { editor?.destroy?.(); return; }
              const initialValue = fallback?.value ?? node.dataset.markdownValue ?? "";
              node.__markdownEditorRef = editor;
              editor?.setValue?.(initialValue);
              if (fallback) fallback.value = initialValue;
              ready = true;
              for (const editable of adminElements("[contenteditable]", HTMLElement, node)) editable.setAttribute("aria-labelledby", node.getAttribute("aria-labelledby") || "");
              if (node.closest('[data-moderation-readonly="true"]') || node.closest("fieldset:disabled")) editor?.disabled?.();
              enhanceVditorToolbar(node);
              shell?.classList.add("is-mounted");
              requestAnimationFrame(() => {
                node.querySelector<HTMLButtonElement>(".vditor-toolbar button")?.blur?.();
                // 只收回本编辑器内部的焦点，避免正在输入的搜索框被抢焦点
                const active = document.activeElement;
                if (active instanceof HTMLElement && shell?.contains(active)) active.blur();
              });
            },
            input(value: string) {
              if (!ready || !node.isConnected) return;
              if (fallback) fallback.value = value;
              node.__markdownOnInput?.(value);
            },
          });
          node.dataset.markdownMounted = "1";
          markdownEditors.push({ editor, node });
        } catch {
          shell?.classList.remove("is-mounted");
        }
      }
    }

    function toolbarItemLabel(value: string) {
      return toolbarOptions.find(([key]) => key === value)?.[1] || value;
    }

    function renderToolbarCheckGroup(root: HTMLElement, toolbar: string[], onChange: (toolbar: string[]) => void) {
      root.innerHTML = "";
      let current = [...toolbar];
      const items = document.createElement("div");
      items.className = "editor-toolbar-grid";
      for (const [key, label] of toolbarOptions) {
        const item = document.createElement("label");
        item.className = "admin-check-field editor-toolbar-option";
        const input = document.createElement("input");
        input.type = "checkbox";
        input.checked = current.includes(key);
        input.addEventListener("change", () => {
          if (input.checked) {
            if (!current.includes(key)) current.push(key);
          } else {
            current = current.filter((item) => item !== key);
          }
          onChange([...current]);
        });
        const text = document.createElement("span");
        text.textContent = label;
        item.append(input, text);
        items.append(item);
      }
      root.append(items);
    }

    function renderEditorSettingsAdmin() {
      const current = editorSettingsState;
      if (!current) return;
      editorSettingsAdminStatus.textContent = "";
      editorUserSettings.innerHTML = "";
      editorAdminSettings.innerHTML = "";
      const userWrap = document.createElement("div");
      userWrap.className = "editor-settings-block";
      userWrap.innerHTML = `<p class="muted">用户提交评价/反馈时可使用的 Markdown 工具栏选项。</p>`;
      const userToolbar = document.createElement("div");
      renderToolbarCheckGroup(userToolbar, current.user?.toolbar || defaultUserToolbar, (next) => {
        current.user = current.user || {};
        current.user.toolbar = next;
      });
      userWrap.append(userToolbar);

      const adminWrap = document.createElement("div");
      adminWrap.className = "editor-settings-block";
      adminWrap.innerHTML = `<p class="muted">后台页面中可用的 Markdown 工具栏选项。</p>`;
      const adminToolbar = document.createElement("div");
      renderToolbarCheckGroup(adminToolbar, current.admin?.toolbar || defaultAdminToolbar, (next) => {
        current.admin = current.admin || {};
        current.admin.toolbar = next;
      });
      adminWrap.append(adminToolbar);

      editorUserSettings.append(userWrap);
      editorAdminSettings.append(adminWrap);
    }

    async function saveEditorSettings(message = "已保存编辑器设置") {
      editorSettingsAdminStatus.textContent = "保存中...";
      const data = await api("/editor-settings", {
        method: "POST",
        body: JSON.stringify({ data: editorSettingsState }),
      });
      editorSettingsState = data.data;
      editorSettingsAdminStatus.textContent = message;
      renderEditorSettingsAdmin();
    }

    function checkboxField(label: string, value: boolean | undefined, onInput: (value: boolean) => void) {
      const wrap = document.createElement("label");
      wrap.className = "admin-check-field";
      const input = document.createElement("input");
      input.type = "checkbox";
      input.checked = Boolean(value);
      input.addEventListener("change", () => onInput(input.checked));
      const labelEl = document.createElement("span");
      labelEl.textContent = label;
      wrap.append(input, labelEl);
      return wrap;
    }

    function numberField(label: string, value: number, onInput: (value: number) => void) {
      const wrap = field(label, value, (next) => onInput(Number(next || 0)));
      requireAdminElement("input", HTMLInputElement, wrap).type = "number";
      requireAdminElement("input", HTMLInputElement, wrap).min = "0";
      return wrap;
    }

    function selectField(label: string, value: string | undefined, options: [string, string][], onInput: (value: string, select: HTMLSelectElement) => void) {
      const wrap = document.createElement("label");
      wrap.className = "admin-field";
      const labelEl = document.createElement("span");
      labelEl.textContent = label;
      const select = document.createElement("select");
      for (const [optionValue, optionLabel] of options) {
        const option = document.createElement("option");
        option.value = optionValue;
        option.textContent = optionLabel;
        option.selected = String(value ?? "") === String(optionValue);
        select.append(option);
      }
      select.addEventListener("change", () => onInput(select.value, select));
      wrap.append(labelEl, select);
      return wrap;
    }

    function appendPagination(container: HTMLElement, total: number, currentPage: number, onPage: (page: number) => void) {
      if (total <= adminPageSize) return;
      const pages = Math.max(1, Math.ceil(total / adminPageSize));
      const pager = document.createElement("div");
      pager.className = "pagination";
      const prev = document.createElement("button");
      prev.type = "button";
      prev.className = "button secondary";
      prev.textContent = "上一页";
      prev.disabled = currentPage <= 1;
      prev.addEventListener("click", () => onPage(currentPage - 1));
      const next = document.createElement("button");
      next.type = "button";
      next.className = "button secondary";
      next.textContent = "下一页";
      next.disabled = currentPage >= pages;
      next.addEventListener("click", () => onPage(currentPage + 1));
      const label = document.createElement("span");
      label.className = "muted";
      label.textContent = `第 ${currentPage} / ${pages} 页，共 ${total} 项`;
      pager.append(prev, label, next);
      container.append(pager);
    }

    const handlingOptions: [string, string][] = [["open", "待处理"], ["processing", "处理中"], ["completed", "已完成"], ["rejected", "不予处理 / 不成立"], ["parked", "搁置"]];
    const handlingLabels = Object.fromEntries(handlingOptions);
    const publicationLabels: Record<string, string> = { pending: "公开待审", approved: "公开已批准", rejected: "公开已拒绝" };
    const moderationFieldLabels: Record<string, string> = { handlingStatus: "处理进度", hidden: "隐藏", publicationDecision: "公开决定", reply: "回复内容", replyVisibility: "回复可见范围", title: "页面标题", announcement: "公告", rules: "规则设置" };
    const publicationDecisionLabels: Record<string, string> = { approve: "批准公开", reject: "拒绝公开", revoke: "撤销批准" };
    const typeLabels: Record<string, string> = { bug: "Bug", feature: "功能改进", content: "内容问题", report: "违法举报", complaint: "内容投诉" };

    function moderationWritable(kind: ModerationKind) {
      return hasPerm(kind === "reviews" ? "content.edit" : "content.moderate");
    }

    function savedModerationItems(kind: ModerationKind): ModerationRecord[] {
      const items = kind === "reviews" ? reviewState?.reviews : feedbackState?.items;
      return (items ?? []).map((item) => moderationDrafts[kind].read(item.id).saved);
    }

    function permanentlyPrivate(item: ModerationRecord) {
      return item.private === true || ["report", "complaint"].includes(item.type || "");
    }

    function publicationSummary(item: ModerationRecord) {
      if (permanentlyPrivate(item)) return "始终私密";
      if (item.publicationBlocked) return `禁止公开：${item.publicationBlockedReason === "LEGACY_PRIVACY_UNCONFIRMED" ? "历史隐私来源未确认" : item.publicationBlockedReason || "需要核查"}`;
      if (item.hidden) return "已隐藏，公众不可见";
      if (item.publicEligible === true) return "公众可见";
      return `${publicationLabels[item.publicationState || ""] || "公开状态待核查"}，公众不可见`;
    }

    function moderationProvenance(item: ModerationRecord) {
      const sources: Record<string, string> = { automatic_rules: "按配置规则自动决定", automatic: "按配置规则自动决定", admin_decision: "管理员明确决定", manual: "管理员明确决定", legacy_visibility_import: "历史可见性导入（不代表历史人工批准）", legacy_feedback_visibility_import: "保留历史公开状态", submission_pending: "新提交待公开审核", legacy_unconfirmed: "历史公开决定未确认" };
      const parts = [];
      if (item.decisionSource) parts.push(sources[item.decisionSource] || `决定来源：${item.decisionSource}`);
      if (item.reviewedBy) parts.push(`决定人 ${item.reviewedBy} · ${beijingDateTime(item.reviewedAt)}`);
      if (item.ruleHash) {
        parts.push(`规则版本 ${item.ruleHash}`);
        parts.push(`规则要求人工审核：${item.ruleSnapshot?.moderationRequired ? "是" : "否"}；关键词过滤：${item.ruleSnapshot?.keywordFilter?.enabled ? "开启" : "关闭"}`);
        if (item.ruleConfiguredAt) parts.push(`规则配置 ${item.ruleConfiguredBy || "历史配置导入"} · ${beijingDateTime(item.ruleConfiguredAt)}`);
      }
      if (item.flagged) parts.push(`规则命中：${item.flagged}`);
      for (const [actor, time, label] of [["handledBy", "handledAt", "处理"], ["repliedBy", "repliedAt", "回复"], ["updatedBy", "updatedAt", "更新"]]) {
        if (item[actor]) parts.push(`${label}人 ${item[actor]} · ${beijingDateTime(typeof item[time] === "string" || typeof item[time] === "number" ? item[time] : undefined)}`);
      }
      return parts.join("\n");
    }

    function replaceSavedModerationItem(kind: ModerationKind, item: ModerationRecord) {
      const document = (kind === "reviews" ? reviewState : feedbackState)!;
      const key = kind === "reviews" ? "reviews" : "items";
      document[key] = (document[key] ?? []).map((existing) => String(existing.id) === String(item.id) ? item : existing);
    }

    function rerenderModeration(kind: ModerationKind, { settings = false } = {}) {
      if (kind === "reviews") renderReviewAdmin({ rebuildRules: settings });
      else {
        renderFeedbackAdmin({ rebuildRules: settings });
        if (feedbackState) renderReportsAdmin();
      }
    }

    function refreshModerationRow(row: HTMLElement, kind: ModerationKind, id: string) {
      const draft = moderationDrafts[kind].read(id);
      row.dataset.dirty = String(draft.dirty);
      row.setAttribute("aria-busy", String(draft.saving));
      row.querySelector<HTMLFieldSetElement>(".moderation-editor-fields")!.disabled = draft.saving || Boolean(draft.conflict) || !moderationWritable(kind);
      const save = row.querySelector<HTMLButtonElement>(".moderation-save")!;
      save.disabled = !moderationWritable(kind) || draft.saving || !draft.dirty || Boolean(draft.conflict) || String(draft.value.reply || "").length > 2000;
      save.textContent = draft.saving ? "保存本条中…" : "保存本条";
      row.querySelector<HTMLButtonElement>(".moderation-cancel")!.disabled = draft.saving || (!draft.dirty && !draft.conflict);
      row.querySelector<HTMLButtonElement>(".moderation-cancel")!.textContent = draft.conflict ? "丢弃草稿并加载服务器当前" : "取消本条草稿";
      row.querySelector<HTMLElement>(".moderation-row-status")!.textContent = draft.saving ? "正在保存本条…" : draft.error || draft.message || (draft.dirty ? "本条有未保存改动" : "本条没有未保存改动");
      row.querySelector<HTMLElement>(".moderation-draft-decision")!.textContent = draft.changes.publicationDecision ? `待保存的公开决定：${publicationDecisionLabels[String(draft.changes.publicationDecision)]}` : "公开决定未修改";
      const count = findAdminElement(".moderation-reply-count", HTMLElement, row);
      if (count) count.textContent = `${String(draft.value.reply || "").length} / 2000 字${String(draft.value.reply || "").length > 2000 ? "；回复过长，请缩减后保存" : ""}`;
      for (const button of row.querySelectorAll<HTMLButtonElement>("[data-publication-decision]")) {
        const selected = draft.changes.publicationDecision === button.dataset.publicationDecision;
        button.setAttribute("aria-pressed", String(selected));
        button.classList.toggle("secondary", !selected);
      }
      for (const entry of markdownEditors) {
        if (!row.contains(entry.node)) continue;
        if (draft.saving || draft.conflict || !moderationWritable(kind)) entry.editor?.disabled?.();
        else entry.editor?.enable?.();
      }
      refreshModerationDraftNotice();
    }

    function refreshVisibleModerationRows(kind: ModerationKind, id: string) {
      for (const row of document.querySelectorAll<HTMLElement>(".moderation-row")) {
        if (row.dataset.moderationKind === kind && row.dataset.moderationId === String(id)) refreshModerationRow(row, kind, id);
      }
    }

    function conflictValue(field: string, value: unknown) {
      if (field === "publicationDecision") return publicationDecisionLabels[String(value)] || "未修改";
      if (field === "handlingStatus") return handlingLabels[String(value)] || String(value ?? "");
      if (field === "hidden") return value ? "已隐藏" : "未隐藏";
      if (field === "replyVisibility") return value === "public" ? "公众可见（需公开条件成立）" : "仅提交者";
      return typeof value === "object" ? JSON.stringify(value, null, 2) : String(value ?? "（空）");
    }

    function renderModerationConflict(root: HTMLElement | null, kind: ModerationKind, { settings = false } = {}) {
      if (!root) return;
      const store = settings ? moderationSettingsDrafts[kind] : moderationDrafts[kind];
      const id = settings ? "settings" : root.closest<HTMLElement>(".moderation-row")!.dataset.moderationId!;
      const draft = store.read(id);
      root.innerHTML = "";
      root.hidden = !draft.conflict;
      if (!draft.conflict) return;
      const heading = document.createElement("strong");
      heading.textContent = "服务器已有其他改动，本次未覆盖。请选择各字段使用哪个值。";
      root.append(heading);
      const choices: Record<string, string> = {};
      for (const [field, mine] of Object.entries(draft.changes)) {
        const wrap = document.createElement("div");
        wrap.className = "moderation-conflict-field";
        const label = moderationFieldLabels[field] || field;
        const serverValue = field === "publicationDecision" ? draft.conflict.item.publicationState : draft.conflict.item[field];
        const beforeValue = field === "publicationDecision" ? draft.saved.publicationState : draft.saved[field];
        const title = document.createElement("strong");
        title.textContent = label;
        const values = document.createElement("div");
        values.className = "moderation-conflict-values";
        const conflictValues: [string, unknown][] = [["编辑前", beforeValue], ["服务器当前", serverValue], ["我的草稿", mine]];
        for (const [name, value] of conflictValues) {
          const cell = document.createElement("div");
          const cellLabel = document.createElement("small");
          cellLabel.textContent = name;
          const content = document.createElement("pre");
          content.textContent = field === "publicationDecision" && name !== "我的草稿" ? publicationLabels[String(value)] || String(value || "") : conflictValue(field, value);
          cell.append(cellLabel, content);
          values.append(cell);
        }
        const choice = selectField(`${label}冲突处理`, "", [["", "请选择处理方式"], ["mine", "保留我的草稿"], ["server", "使用服务器当前值"]], (value: string) => { choices[field] = value; });
        wrap.append(title, values, choice);
        root.append(wrap);
      }
      const current = document.createElement("details");
      const summary = document.createElement("summary");
      summary.textContent = "查看服务器当前完整记录";
      const json = document.createElement("pre");
      json.textContent = JSON.stringify(draft.conflict.item, null, 2);
      current.append(summary, json);
      const actions = document.createElement("div");
      actions.className = "filter-row";
      const resolve = document.createElement("button");
      resolve.type = "button";
      resolve.className = "button secondary";
      resolve.textContent = "按选择加载最新版本";
      const message = document.createElement("p");
      message.setAttribute("role", "status");
      resolve.addEventListener("click", () => {
        try {
          store.resolve(id, choices);
          if (!settings) replaceSavedModerationItem(kind, store.read(id).saved);
          rerenderModeration(kind, { settings });
        } catch (error) { message.textContent = error instanceof Error ? adminErrorMessage(error) : String(error); }
      });
      const drop = document.createElement("button");
      drop.type = "button";
      drop.className = "button secondary";
      drop.textContent = "丢弃本条草稿并加载最新";
      drop.addEventListener("click", () => {
        store.cancel(id);
        if (!settings) replaceSavedModerationItem(kind, store.read(id).saved);
        rerenderModeration(kind, { settings });
      });
      actions.append(resolve, drop);
      root.append(current, actions, message);
    }

    async function saveModerationItem(kind: ModerationKind, id: string) {
      const store = moderationDrafts[kind];
      try {
        const payload = store.begin(id);
        refreshVisibleModerationRows(kind, id);
        const data = await api(`/${kind}/${encodeURIComponent(id)}`, { method: "PATCH", body: JSON.stringify(payload), signal: AbortSignal.timeout(20000) });
        if (!data.data || String(data.data.id) !== String(id)) throw new Error("服务器未返回本条保存结果，草稿已保留，请核对后重试。");
        const item = { ...data.data, publicEligible: data.publicEligible === true };
        store.succeed(id, item, data.itemRevision);
        replaceSavedModerationItem(kind, item);
        refreshPendingCounts();
      } catch (error) {
        const requestError = error instanceof Error ? error as ModerationRequestError : null;
        const response = requestError?.responseData;
        store.fail(id, requestError?.name === "TimeoutError" ? "保存超时；草稿已保留，请核对后重试。" : error, response?.currentItem && response?.currentItemRevision ? { item: response.currentItem, revision: response.currentItemRevision } : null);
      }
      rerenderModeration(kind);
    }

    function renderModerationRow(kind: ModerationKind, saved: ModerationRecord) {
      const store = moderationDrafts[kind];
      const draft = store.read(saved.id);
      const value = draft.value;
      const privateItem = permanentlyPrivate(saved);
      const row = document.createElement("article");
      row.className = "review-admin-item moderation-row";
      row.dataset.moderationKind = kind;
      row.dataset.moderationId = String(saved.id);
      const account = saved.user_id != null ? `提交账号 user_id=${saved.user_id}` : "无账号关联（匿名提交）";
      row.innerHTML = `
        <div class="course-meta">
          ${kind === "feedback" ? `<span class="pill">原始类型：${escapeHtml(typeLabels[saved.type || ""] || saved.type || "反馈")}</span><span class="pill">处理进度：${escapeHtml(handlingLabels[saved.handlingStatus || ""] || "待处理")}</span>` : `<span class="pill">${escapeHtml(saved.courseTitle || "未命名课程")}</span><span class="pill">${escapeHtml(saved.teacher || "未填写老师")}</span><span class="pill">评分 ${escapeHtml(saved.rating ?? "未填写")}</span>`}
          <span class="pill">${escapeHtml(publicationSummary(saved))}</span>
        </div>
        <h3>${escapeHtml(kind === "feedback" ? saved.title || "无标题" : "用户评价原文")}</h3>
        ${saved.resourceRef ? `<p class="muted">关联资源：${escapeHtml(saved.resourceRef)}</p>` : ""}
        ${saved.report_url || saved.report_target || saved.reportUrl || saved.reportTarget ? `<p class="muted">举报对象：${escapeHtml(saved.report_target || saved.reportTarget || "")} ${escapeHtml(saved.report_url || saved.reportUrl || "")}</p>` : ""}
        <p class="moderation-original">${escapeHtml(saved.content || "")}</p>
        <p class="muted">${escapeHtml(account)} · 提交时间 ${escapeHtml(beijingDateTime(saved.createdAt))}${kind === "feedback" ? `<br />联系方式：${escapeHtml(saved.contact || "未提供")}` : ""}</p>
        ${saved.reply ? `<div class="moderation-saved-reply"><strong>已保存回复 · ${saved.replyVisibility === "public" && !privateItem ? "设为公众可见（需条目公开条件成立）" : "仅提交者"}</strong><p class="moderation-original">${escapeHtml(saved.reply)}</p></div>` : ""}
        <p class="moderation-provenance muted">${escapeHtml(moderationProvenance(saved))}</p>
      `;
      if (saved.ruleSnapshot) {
        const rules = document.createElement("details");
        const summary = document.createElement("summary");
        summary.textContent = "查看本次规则决定的快照（只读）";
        const snapshot = document.createElement("pre");
        snapshot.className = "moderation-rule-snapshot";
        snapshot.textContent = JSON.stringify(saved.ruleSnapshot, null, 2);
        rules.append(summary, snapshot);
        row.append(rules);
      }
      const editor = document.createElement("details");
      editor.className = "moderation-editor";
      editor.open = moderationEditorsOpen[kind].has(saved.id) || draft.dirty || Boolean(draft.conflict);
      const summary = document.createElement("summary");
      summary.textContent = kind === "feedback" ? "处置与回复（单条草稿）" : "公开与隐藏（单条草稿）";
      const fields = document.createElement("fieldset");
      fields.className = "admin-form moderation-editor-fields";
      const legend = document.createElement("legend");
      legend.textContent = "原文与提交归属只读，以下改动需保存本条";
      fields.append(legend);
      const change = (field: string, next: unknown) => { store.change(saved.id, field, next); refreshVisibleModerationRows(kind, saved.id); };
      if (kind === "feedback") fields.append(selectField("处理进度（与公开决定独立）", value.handlingStatus || "open", handlingOptions, (next: string) => change("handlingStatus", next)));
      fields.append(checkboxField("隐藏（隐藏或取消隐藏不改变公开批准）", value.hidden === true, (next: boolean) => change("hidden", next)));
      const decisions = document.createElement("div");
      decisions.className = "filter-row";
      if (!privateItem) {
        for (const [decision, label] of Object.entries(publicationDecisionLabels)) {
          const button = document.createElement("button");
          button.type = "button";
          button.className = "button secondary";
          button.dataset.publicationDecision = decision;
          button.textContent = `${label}（待保存）`;
          button.disabled = decision === "approve" && saved.publicationBlocked === true;
          button.addEventListener("click", () => change("publicationDecision", decision));
          decisions.append(button);
        }
      }
      const draftDecision = document.createElement("p");
      draftDecision.className = "moderation-draft-decision muted";
      draftDecision.setAttribute("role", "status");
      fields.append(decisions, draftDecision);
      if (kind === "feedback") {
        const hint = document.createElement("p");
        hint.className = "field-hint";
        hint.textContent = privateItem ? "本条始终私密，回复仅提交者可见。" : "回复不会改变处理进度或批准公开。公开回复只有在本条批准、未隐藏且通过服务端公开检查时可见。";
        if (saved.user_id == null) hint.textContent += " 本条无账号关联，无法通过「我的反馈」向提交者送达；不要承诺站内回复可达。";
        fields.append(hint);
        const reply = markdownField("管理员回复（最多 2000 字；支持 Markdown）", value.reply || "", (next: string) => change("reply", next), { height: 200 });
        const count = document.createElement("small");
        count.className = "moderation-reply-count";
        reply.append(count);
        fields.append(reply);
        const clear = document.createElement("button");
        clear.type = "button";
        clear.className = "button secondary";
        clear.textContent = "清空回复（待保存）";
        clear.addEventListener("click", () => {
          change("reply", "");
          reply.querySelector<HTMLTextAreaElement>("textarea")!.value = "";
          const node = reply.querySelector<MarkdownEditorNode>("[data-markdown-editor]")!;
          node.dataset.markdownValue = "";
          node.__markdownEditorRef?.setValue?.("");
        });
        fields.append(clear);
        if (!privateItem) fields.append(selectField("回复可见范围", value.replyVisibility || "submitter", [["submitter", "仅提交者"], ["public", "公众可见（需公开条件成立）"]], (next: string) => change("replyVisibility", next)));
      }
      const actions = document.createElement("div");
      actions.className = "filter-row";
      const save = document.createElement("button");
      save.type = "button";
      save.className = "button moderation-save";
      save.addEventListener("click", () => saveModerationItem(kind, saved.id));
      const cancel = document.createElement("button");
      cancel.type = "button";
      cancel.className = "button secondary moderation-cancel";
      cancel.textContent = "取消本条草稿";
      cancel.addEventListener("click", () => {
        store.cancel(saved.id);
        replaceSavedModerationItem(kind, store.read(saved.id).saved);
        rerenderModeration(kind);
      });
      const status = document.createElement("span");
      status.className = "muted moderation-row-status";
      status.setAttribute("role", "status");
      status.setAttribute("aria-live", "polite");
      actions.append(save, cancel, status);
      const conflict = document.createElement("div");
      conflict.className = "moderation-conflict";
      editor.append(summary, fields, actions, conflict);
      editor.addEventListener("toggle", () => {
        if (editor.open) { moderationEditorsOpen[kind].add(saved.id); mountMarkdownEditors(editor, "admin", { destroy: false }); }
        else moderationEditorsOpen[kind].delete(saved.id);
      });
      row.append(editor);
      refreshModerationRow(row, kind, saved.id);
      renderModerationConflict(conflict, kind);
      return row;
    }

    function refreshModerationSettingsControls(kind: ModerationKind) {
      if (!(kind === "reviews" ? reviewState : feedbackState)) return;
      const store = moderationSettingsDrafts[kind];
      const draft = store.read("settings");
      const save = document.querySelector<HTMLButtonElement>(kind === "reviews" ? "#save-reviews" : "#save-feedback")!;
      const cancel = document.querySelector<HTMLButtonElement>(kind === "reviews" ? "#cancel-review-settings" : "#cancel-feedback-settings")!;
      save.disabled = !moderationWritable(kind) || draft.saving || !draft.dirty || Boolean(draft.conflict);
      cancel.disabled = draft.saving || (!draft.dirty && !draft.conflict);
      cancel.textContent = draft.conflict ? "丢弃设置草稿并加载服务器当前" : "取消设置草稿";
      const status = kind === "reviews" ? reviewAdminStatus : feedbackAdminStatus;
      status.textContent = draft.saving ? "正在保存设置…" : draft.error || draft.message || (draft.dirty ? "设置有未保存改动（与条目独立）" : `设置已加载 · 版本 ${draft.revision.slice(0, 12)}`);
      const provenance = draft.saved.rulesProvenance;
      document.querySelector<HTMLElement>(`#${kind === "reviews" ? "review" : "feedback"}-settings-provenance`)!.textContent = provenance ? `已保存规则版本 ${provenance.hash}\n${provenance.source === "admin_settings" ? `配置人 ${provenance.configuredBy || "未提供"}` : "历史规则配置导入（无历史管理员批准证据）"} · ${beijingDateTime(provenance.configuredAt)}` : "";
      const roots = kind === "reviews" ? [reviewRulesEditor] : [feedbackSettingsEditor, feedbackRulesEditor];
      for (const root of roots) {
        root.setAttribute("aria-busy", String(draft.saving));
        root.dataset.moderationReadonly = String(draft.saving || Boolean(draft.conflict) || !moderationWritable(kind));
        for (const input of root.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>("input, select, textarea")) input.disabled = draft.saving || Boolean(draft.conflict) || !moderationWritable(kind);
        for (const entry of markdownEditors) {
          if (!root.contains(entry.node)) continue;
          if (moderationWritable(kind) && !draft.saving && !draft.conflict) entry.editor?.enable?.();
          else entry.editor?.disabled?.();
        }
      }
      renderModerationConflict(document.querySelector<HTMLElement>(`#${kind === "reviews" ? "review" : "feedback"}-settings-conflict`), kind, { settings: true });
      refreshModerationDraftNotice();
    }

    function changeModerationSetting(kind: ModerationKind, field: string, value: unknown) {
      moderationSettingsDrafts[kind].change("settings", field, value);
      refreshModerationSettingsControls(kind);
    }

    async function saveModerationSettings(kind: ModerationKind) {
      const store = moderationSettingsDrafts[kind];
      try {
        const payload = store.begin("settings");
        refreshModerationSettingsControls(kind);
        const data = await api(`/${kind}/settings`, { method: "PATCH", body: JSON.stringify(payload), signal: AbortSignal.timeout(20000) });
        if (!data.data?.rules) throw new Error("服务器未返回设置保存结果，草稿已保留，请核对后重试。");
        store.succeed("settings", { ...data.data, rulesProvenance: data.rulesProvenance, id: "settings" }, data.settingsRevision, "已保存设置；条目草稿保持独立。" );
        const document = (kind === "reviews" ? reviewState : feedbackState)!;
        for (const field of kind === "reviews" ? ["rules"] : ["title", "announcement", "rules"]) if (Object.hasOwn(data.data, field)) document[field] = data.data[field];
      } catch (error) {
        const requestError = error instanceof Error ? error as ModerationRequestError : null;
        const response = requestError?.responseData;
        store.fail("settings", requestError?.name === "TimeoutError" ? "保存超时；设置草稿已保留，请核对后重试。" : error, response?.currentSettings && response?.currentSettingsRevision ? { item: { ...response.currentSettings, id: "settings" }, revision: response.currentSettingsRevision } : null);
      }
      rerenderModeration(kind, { settings: true });
    }

    function hasModerationUnsaved() {
      return Object.values(moderationDrafts).some((store) => store.hasUnsaved()) || Object.values(moderationSettingsDrafts).some((store) => store.hasUnsaved());
    }

    function refreshModerationDraftNotice() {
      const notice = document.querySelector<HTMLElement>("#moderation-drafts-notice")!;
      notice.hidden = !hasModerationUnsaved();
      notice.textContent = "有未保存的处置或设置草稿。切换后台页面、筛选或重新加载列表会保留草稿；关闭页面将丢失。";
    }

    function confirmModerationDeparture() {
      if (Object.values(moderationDrafts).some((store) => store.isSaving()) || Object.values(moderationSettingsDrafts).some((store) => store.isSaving())) {
        alert("有正在保存的条目或设置，请等待结果后再退出。");
        return false;
      }
      return !hasModerationUnsaved() || confirm("有未保存的处置或设置草稿。离开会丢失这些草稿，仍要离开吗？");
    }

    window.addEventListener("beforeunload", (event) => {
      if (moderationDepartureConfirmed || !hasModerationUnsaved()) return;
      event.preventDefault();
      event.returnValue = "";
    });

    function renderReviewAdminSidebar(groups: ModerationGroup[], allReviews: ModerationRecord[]) {
      reviewAdminSidebar.innerHTML = "";
      const totalPending = groups.reduce((sum, entry) => sum + entry.pending, 0);
      const allButton = document.createElement("button");
      allButton.type = "button";
      allButton.className = "admin-tree-course";
      allButton.dataset.active = reviewAdminSelected === "" ? "true" : "false";
      allButton.innerHTML = `<strong>全部课程</strong><small>${allReviews.length} 条 · 待审 ${totalPending}</small>`;
      allButton.addEventListener("click", () => {
        reviewAdminSelected = "";
        reviewAdminPage = 1;
        renderReviewAdmin({ rebuildRules: false });
      });
      reviewAdminSidebar.append(allButton);
      for (const entry of groups) {
        const button = document.createElement("button");
        button.type = "button";
        button.className = "admin-tree-course";
        button.dataset.active = reviewAdminSelected === entry.key ? "true" : "false";
        button.innerHTML = `
          <strong>${escapeHtml(entry.key)}</strong>
          <small>${entry.pending ? `<span class="pill">待审 ${entry.pending}</span> ` : ""}共 ${entry.total} 条</small>
        `;
        button.addEventListener("click", () => {
          reviewAdminSelected = entry.key;
          reviewAdminPage = 1;
          renderReviewAdmin({ rebuildRules: false });
        });
        reviewAdminSidebar.append(button);
      }
    }

    function renderReviewAdmin({ rebuildRules = true } = {}) {
      if (!reviewState) return;
      const settings = moderationSettingsDrafts.reviews.read("settings");
      const rules: ModerationRules = settings.value.rules ?? {};
      const changeRules = () => changeModerationSetting("reviews", "rules", rules);
      if (rebuildRules) {
        destroyMarkdownEditors(reviewRulesEditor);
        reviewRulesEditor.innerHTML = "";
        const hint = document.createElement("p");
        hint.className = "field-hint";
        hint.textContent = "保留配置规则自动公开：开启人工审核或命中已启用关键词规则时待审，否则自动公开。修改规则只影响规则设置，不保存列表中的草稿。";
        reviewRulesEditor.append(hint,
          checkboxField("开放用户提交", rules.submissionOpen !== false, (value: boolean) => { rules.submissionOpen = value; changeRules(); }),
          checkboxField("提交后需要人工审核", rules.moderationRequired === true, (value: boolean) => { rules.moderationRequired = value; changeRules(); }),
          checkboxField("启用 Turnstile（预留）", rules.turnstileEnabled === true, (value: boolean) => { rules.turnstileEnabled = value; changeRules(); }),
          numberField("每小时提交上限", rules.hourlyLimit ?? 3, (value: number) => { rules.hourlyLimit = value; changeRules(); }),
          numberField("每日提交上限", rules.dailyLimit ?? 10, (value: number) => { rules.dailyLimit = value; changeRules(); }),
          numberField("评价最少字数", rules.minLength ?? 12, (value: number) => { rules.minLength = value; changeRules(); }),
          checkboxField("允许自定义课程名", rules.submissionOptions?.allowCustomCourse === true, (value: boolean) => { (rules.submissionOptions ??= {}).allowCustomCourse = value; changeRules(); }),
          checkboxField("允许自定义教师名", rules.submissionOptions?.allowCustomTeacher !== false, (value: boolean) => { (rules.submissionOptions ??= {}).allowCustomTeacher = value; changeRules(); }),
          markdownField("评价公告栏（支持 Markdown，可插图）", rules.announcement ?? "", (value: string) => { rules.announcement = value; changeRules(); }, { owner: "reviews" }),
          markdownField("规则备注", rules.notes ?? "", (value: string) => { rules.notes = value; changeRules(); }, { height: 150 })
        );
        const keywordFilter = rules.keywordFilter ?? { enabled: false, words: [] };
        reviewRulesEditor.append(
          checkboxField("启用关键词过滤（命中联系方式或敏感词时待审）", keywordFilter.enabled === true, (value: boolean) => { keywordFilter.enabled = value; rules.keywordFilter = keywordFilter; changeRules(); }),
          field("自定义敏感词（每行一个）", (keywordFilter.words || []).join("\n"), (value: string) => { keywordFilter.words = value.split(/\r?\n/).map((line: string) => line.trim()).filter(Boolean); rules.keywordFilter = keywordFilter; changeRules(); }, true)
        );
      }
      const allReviews = savedModerationItems("reviews");
      const keyword = reviewAdminSearch.value.trim().toLowerCase();
      const status = reviewStatusFilter.value;
      const sidebarKeyword = reviewAdminSidebarSearch.value.trim().toLowerCase();
      const groupKeyOf = (review: ModerationRecord) => `${review.courseTitle || "未命名课程"} · ${review.teacher || "未填写老师"}`;
      const groups = new Map<string, ModerationGroup>();
      for (const review of allReviews) {
        const key = groupKeyOf(review);
        const group = groups.get(key) || { key, total: 0, pending: 0 };
        group.total += 1;
        if (review.publicationState === "pending" && !review.hidden) group.pending += 1;
        groups.set(key, group);
      }
      if (reviewAdminSelected && !groups.has(reviewAdminSelected)) reviewAdminSelected = "";
      renderReviewAdminSidebar([...groups.values()].filter((group) => !sidebarKeyword || group.key.toLowerCase().includes(sidebarKeyword)).sort((a, b) => (b.pending - a.pending) || (b.total - a.total)), allReviews);
      const reviews = allReviews.filter((review) => {
        const matchesStatus = status === "all" || (status === "hidden" && review.hidden) || (status === "visible" && review.publicEligible === true) || status === review.publicationState;
        const text = `${review.courseTitle} ${review.teacher} ${review.content} ${review.user_id ?? ""}`.toLowerCase();
        return (!reviewAdminSelected || groupKeyOf(review) === reviewAdminSelected) && matchesStatus && (!keyword || text.includes(keyword));
      });
      destroyMarkdownEditors(reviewAdminList);
      reviewAdminList.innerHTML = "";
      if (!reviews.length) reviewAdminList.innerHTML = '<p class="empty">暂无匹配评价。</p>';
      else {
        reviewAdminPage = Math.min(reviewAdminPage, Math.max(1, Math.ceil(reviews.length / adminPageSize)));
        for (const review of reviews.slice((reviewAdminPage - 1) * adminPageSize, reviewAdminPage * adminPageSize)) reviewAdminList.append(renderModerationRow("reviews", review));
        appendPagination(reviewAdminList, reviews.length, reviewAdminPage, (page: number) => { reviewAdminPage = page; renderReviewAdmin({ rebuildRules: false }); });
      }
      mountMarkdownEditors(reviewAdminPanel, "admin", { destroy: false });
      refreshModerationSettingsControls("reviews");
    }

    function renderFeedbackAdmin({ rebuildRules = true } = {}) {
      if (!feedbackState) return;
      const settings = moderationSettingsDrafts.feedback.read("settings");
      const rules: ModerationRules = settings.value.rules ?? {};
      const changeRules = () => changeModerationSetting("feedback", "rules", rules);
      if (rebuildRules) {
        destroyMarkdownEditors(feedbackSettingsEditor);
        destroyMarkdownEditors(feedbackRulesEditor);
        feedbackSettingsEditor.innerHTML = "";
        feedbackSettingsEditor.append(
          field("反馈页标题", settings.value.title ?? "问题与建议", (value: string) => changeModerationSetting("feedback", "title", value)),
          markdownField("反馈页公告（支持 Markdown，可插图）", settings.value.announcement ?? "", (value: string) => changeModerationSetting("feedback", "announcement", value), { owner: "feedback" })
        );
        feedbackRulesEditor.innerHTML = "";
        feedbackRulesEditor.append(
          checkboxField("开放普通反馈提交（投诉举报独立受理）", rules.submissionOpen !== false, (value: boolean) => { rules.submissionOpen = value; changeRules(); }),
          numberField("每小时提交上限", rules.hourlyLimit ?? 3, (value: number) => { rules.hourlyLimit = value; changeRules(); }),
          numberField("每日提交上限", rules.dailyLimit ?? 15, (value: number) => { rules.dailyLimit = value; changeRules(); }),
          numberField("反馈最少字数", rules.minLength ?? 5, (value: number) => { rules.minLength = value; changeRules(); }),
          markdownField("规则备注", rules.notes ?? "", (value: string) => { rules.notes = value; changeRules(); }, { height: 150 })
        );
      }
      const keyword = feedbackAdminSearch.value.trim().toLowerCase();
      const status = feedbackStatusFilter.value;
      const items = savedModerationItems("feedback").filter((item) => {
        const text = `${item.title} ${item.content} ${item.contact} ${item.type} ${item.user_id ?? ""}`.toLowerCase();
        const matchesStatus = status === "all" || (status === "hidden" && item.hidden) || (status.startsWith("public-") && item.publicationState === status.slice(7)) || status === item.handlingStatus;
        return matchesStatus && (!keyword || text.includes(keyword));
      });
      destroyMarkdownEditors(feedbackAdminList);
      feedbackAdminList.innerHTML = "";
      if (!items.length) feedbackAdminList.innerHTML = '<p class="empty">暂无匹配反馈。</p>';
      else {
        feedbackAdminPage = Math.min(feedbackAdminPage, Math.max(1, Math.ceil(items.length / adminPageSize)));
        for (const item of items.slice((feedbackAdminPage - 1) * adminPageSize, feedbackAdminPage * adminPageSize)) feedbackAdminList.append(renderModerationRow("feedback", item));
        appendPagination(feedbackAdminList, items.length, feedbackAdminPage, (page: number) => { feedbackAdminPage = page; renderFeedbackAdmin({ rebuildRules: false }); });
      }
      mountMarkdownEditors(feedbackAdminPanel, "admin", { destroy: false });
      refreshModerationSettingsControls("feedback");
    }

